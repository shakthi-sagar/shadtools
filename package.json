{
  "name": "shadtools",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run validate && npm run build:astro && npm run build:sitemaps && npm run build:search && npm run validate:post-build",
    "build:astro": "astro build",
    "build:sitemaps": "tsx scripts/generate-sitemaps.ts",
    "build:search": "pagefind --site dist",
    "check": "astro check && tsc --noEmit",
    "create-tool": "tsx scripts/create-tool.ts",
    "lint": "eslint .",
    "prepare": "husky",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-tools.ts && tsx scripts/validate-styles.ts && tsx scripts/validate-seo.ts",
    "validate:post-build": "tsx scripts/validate-sitemap.ts && tsx scripts/validate-performance.ts",
    "verify:push": "npm run validate && npx tsc --noEmit && npm run test && npm run build && npm run test:e2e -- --project=chromium"
  },
  "dependencies": {
    "@astrojs/react": "^3.6.2",
    "@astrojs/tailwind": "^5.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^4.15.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.435.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.3",
    "@playwright/test": "^1.46.1",
    "@types/node": "^22.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "husky": "^9.1.7",
    "pagefind": "^1.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
