{
  "name": "shadtools",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run validate && npm run build:astro && npm run build:search",
    "build:astro": "astro build",
    "build:search": "pagefind --site dist",
    "check": "astro check && tsc --noEmit",
    "create-tool": "tsx scripts/create-tool.ts",
    "lint": "eslint .",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "validate": "tsx scripts/validate-tools.ts"
  },
  "dependencies": {
    "@astrojs/react": "^3.6.2",
    "@astrojs/sitemap": "^3.1.4",
    "@astrojs/tailwind": "^5.1.0",
    "astro": "^4.15.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.435.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.3",
    "@playwright/test": "^1.46.1",
    "@types/node": "^22.5.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "pagefind": "^1.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
