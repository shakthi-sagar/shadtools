---
export interface Props {
  slotId?: string;
  format?: 'banner' | 'rectangle';
}

const { slotId = 'default', format = 'banner' } = Astro.props;
---

<div class={`p-4 rounded-xl bg-slate-900/30 border border-slate-800/60 text-center text-xs text-slate-500 ${format === 'banner' ? 'w-full' : 'max-w-md mx-auto'}`} data-ad-slot={slotId}>
  <span>Advertisement</span>
</div>
