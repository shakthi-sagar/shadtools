---
export interface Props {
  slot: 'top-banner' | 'below-tool' | 'content-inline' | 'sidebar';
  className?: string;
}

const { slot, className = '' } = Astro.props;

const heightMap = {
  'top-banner': 'min-h-[90px]',
  'below-tool': 'min-h-[250px]',
  'content-inline': 'min-h-[250px]',
  'sidebar': 'min-h-[600px]'
};
---

<div class={`w-full my-4 flex items-center justify-center bg-slate-900/50 border border-dashed border-slate-800 rounded-lg overflow-hidden text-center p-3 transition-colors ${heightMap[slot]} ${className}`}>
  <div class="space-y-0.5">
    <span class="text-[10px] uppercase font-bold tracking-wider text-slate-500 block">Advertisement Placeholder</span>
    <span class="text-[11px] text-slate-600 font-mono">[{slot}]</span>
  </div>
</div>
