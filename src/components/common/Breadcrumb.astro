---
export interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center gap-2 text-xs text-slate-400 flex-wrap">
    <li>
      <a href="/" class="hover:text-slate-200 transition-colors flex items-center gap-1">
        <span>Home</span>
      </a>
    </li>
    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        <span class="text-slate-600">/</span>
        {index === items.length - 1 ? (
          <span class="text-slate-200 font-semibold" aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-slate-200 transition-colors">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
