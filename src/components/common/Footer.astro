---
import { getCollection } from 'astro:content';

const currentYear = new Date().getFullYear();
const namespaces = await getCollection('namespaces');
---

<footer class="mt-20 border-t border-slate-800 bg-[#090d16] py-12 text-sm text-slate-400">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-3 gap-8">
    
    <div class="space-y-3">
      <a href="/" class="flex items-center gap-2 font-bold text-xl text-white tracking-tight">
        <span class="text-indigo-400 font-extrabold">Shad</span><span class="text-slate-100">Tools</span>
      </a>
      <p class="text-slate-400 text-sm leading-relaxed max-w-sm">
        Free, fast, privacy-first online utility web tools. Format code, convert units, compress images, and calculate values 100% inside your browser tab.
      </p>
    </div>

    <div>
      <h3 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-4">Tool Collections</h3>
      <ul class="grid grid-cols-2 gap-2 text-slate-400">
        {namespaces.map((ns) => (
          <li>
            <a href={`/${ns.slug}`} class="hover:text-indigo-400 transition-colors">
              {ns.data.name}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-4">Legal & Privacy</h3>
      <ul class="space-y-2 text-slate-400">
        <li><a href="/privacy" class="hover:text-indigo-400 transition-colors">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-indigo-400 transition-colors">Terms of Service</a></li>
        <li><a href="/disclaimer" class="hover:text-indigo-400 transition-colors">Disclaimer</a></li>
        <li><a href="/contact" class="hover:text-indigo-400 transition-colors">Contact Us</a></li>
      </ul>
    </div>

  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-6 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500">
    <p>© {currentYear} ShadTools. High performance utility platform.</p>
    <p class="mt-2 sm:mt-0 font-medium text-emerald-400 flex items-center gap-1.5">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
      <span>Processed 100% locally in browser memory</span>
    </p>
  </div>
</footer>
