---
const mainCategories = [
  { name: 'Developer Tools', slug: 'developer-tools' },
  { name: 'Documents', slug: 'document-tools' },
  { name: 'Images', slug: 'image-tools' },
  { name: 'Finance', slug: 'finance-tools' },
  { name: 'Units & Time', slug: 'time-and-unit-tools' }
];
---

<header class="sticky top-0 z-50 bg-[#090d16]/95 backdrop-blur border-b border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between">
    <!-- Brand Wordmark -->
    <a href="/" class="flex items-center gap-2 font-bold text-lg text-white tracking-tight">
      <span class="text-blue-500 font-extrabold">Shad</span><span class="text-slate-200">Tools</span>
    </a>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center gap-5 text-xs font-medium text-slate-300">
      {mainCategories.map((cat) => (
        <a href={`/${cat.slug}`} class="hover:text-white transition-colors py-1">
          {cat.name}
        </a>
      ))}
    </nav>

    <!-- Right Quick Badge -->
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-[11px] font-medium bg-emerald-950/60 text-emerald-400 border border-emerald-800/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        100% In-Browser
      </span>
    </div>
  </div>
</header>
