---
export interface Props {
  toolName: string;
}

const { toolName } = Astro.props;
---

<div class="p-3.5 rounded-lg border border-emerald-800/40 bg-emerald-950/20 text-emerald-300 flex items-center gap-2.5 text-xs">
  <span class="text-sm">🔒</span>
  <p class="leading-relaxed">
    <strong class="font-semibold text-emerald-400">100% In-Browser Privacy:</strong> Your data for <span class="text-white font-medium">{toolName}</span> is processed locally inside your browser memory. Data is never sent to any server.
  </p>
</div>
