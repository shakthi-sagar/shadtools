---
export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  faq: FaqItem[];
}

const { faq } = Astro.props;

if (!faq || faq.length === 0) {
  return null;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faq.map((item) => ({
    '@type': 'Question',
    'name': item.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': item.answer
    }
  }))
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
