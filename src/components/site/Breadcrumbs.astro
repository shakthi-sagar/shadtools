---
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="flex items-center text-xs text-foreground-secondary space-x-1.5 font-sans">
  <a href="/" class="hover:text-foreground transition-colors">Home</a>
  {items.map((item) => (
    <>
      <span class="text-foreground-muted select-none">/</span>
      <a href={item.url} class="hover:text-foreground transition-colors truncate max-w-[200px]">
        {item.name}
      </a>
    </>
  ))}
</nav>
