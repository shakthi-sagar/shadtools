---
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolUrl } from '@/lib/routing';
import { BrowseMenu } from '@/components/site/BrowseMenu';
import { ThemeToggle } from '@/components/site/ThemeToggle';
import { HeaderSearch } from '@/components/site/HeaderSearch';

const namespaces = await getCollection('namespaces');
const namespaceItems = namespaces.map((ns) => ({
  name: ns.data.name,
  slug: getNamespaceSlug(ns),
}));

const toolsCollection = await getCollection('tools');
const searchTools = toolsCollection
  .filter((t) => t.data.status === 'published')
  .map((t) => {
    const [ns, toolSlug] = t.slug.includes('/') ? t.slug.split('/') : [t.data.namespace, t.slug];
    return {
      id: t.slug,
      name: t.data.name,
      namespace: t.data.namespace,
      summary: t.data.summary,
      url: getToolUrl(ns, toolSlug),
      searchWeight: 10,
    };
  });
---

<header class="sticky top-0 z-50 flex h-14 items-center border-b border-border bg-surface/95 backdrop-blur-md">
  <div class="max-w-[1120px] w-full mx-auto px-4 sm:px-6 flex items-center justify-between gap-3">
    <!-- Brand Wordmark & Browse Menu -->
    <div class="flex items-center gap-2 sm:gap-5 shrink-0">
      <a href="/" class="flex items-center gap-2 font-bold text-base text-foreground tracking-tight shrink-0 group">
        <div class="w-6 h-6 rounded-sm bg-action flex items-center justify-center text-action-foreground font-extrabold text-xs">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <span>Shad<span class="text-accent">Tools</span></span>
      </a>

      <!-- Browse Menu Dropdown -->
      <BrowseMenu client:load namespaces={namespaceItems} />
    </div>

    <!-- Search Dropdown & Theme Toggle -->
    <div class="flex items-center gap-2 sm:gap-3 flex-1 justify-end sm:max-w-sm">
      <HeaderSearch client:load tools={searchTools} />
      <ThemeToggle client:load />
    </div>
  </div>
</header>
