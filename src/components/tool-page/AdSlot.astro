---
export interface Props {
  slotId?: string;
}

const { slotId = 'default' } = Astro.props;
---

<div class="flex min-h-20 items-center justify-center border-y border-border bg-surface-subtle/40 px-3 text-[10px] uppercase text-foreground-muted select-none" data-ad-slot={slotId}>
  <span>Advertisement</span>
</div>
