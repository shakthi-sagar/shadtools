---
export interface Props {
  examples: Array<{ title?: string; input: string; output: string }>;
}

const { examples } = Astro.props;
---

{examples && examples.length > 0 && (
  <section class="space-y-4 pt-6 border-t border-border">
    <h2 class="text-xl font-bold text-foreground">Examples</h2>
    <div class="space-y-3">
      {examples.map((ex) => (
        <div class="p-3.5 rounded-md bg-surface border border-border text-xs space-y-2">
          {ex.title && <p class="font-semibold text-foreground text-sm">{ex.title}</p>}
          <div class="font-mono bg-surface-subtle p-2.5 rounded border border-border text-foreground-secondary overflow-x-auto">
            <span class="text-foreground-muted select-none">In: </span>{ex.input}
          </div>
          <div class="font-mono bg-surface-subtle p-2.5 rounded border border-border text-accent overflow-x-auto">
            <span class="text-foreground-muted select-none">Out: </span>{ex.output}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
