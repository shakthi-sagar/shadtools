---
export interface Props { faq: Array<{ question: string; answer: string }>; }
const { faq } = Astro.props;
---

{faq?.length > 0 && (
  <section aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="mb-4 text-xl font-semibold text-foreground">Frequently asked questions</h2>
    <div class="divide-y divide-border overflow-hidden rounded-lg border border-border bg-surface">
      {faq.map((item) => (
        <details class="group px-4 py-4 sm:px-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-foreground hover:text-accent">
            <span>{item.question}</span>
            <span aria-hidden="true" class="text-lg font-normal leading-none text-foreground-muted transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-foreground-secondary">{item.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
