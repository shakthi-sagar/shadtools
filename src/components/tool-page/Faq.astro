---
export interface Props {
  faq: Array<{ question: string; answer: string }>;
}

const { faq } = Astro.props;
---

{faq && faq.length > 0 && (
  <section class="space-y-4 pt-6 border-t border-border">
    <h2 class="text-xl font-bold text-foreground">Frequently Asked Questions</h2>
    <div class="space-y-3">
      {faq.map((item) => (
        <div class="p-4 rounded-lg bg-surface border border-border space-y-1.5">
          <h3 class="font-semibold text-foreground text-sm">{item.question}</h3>
          <p class="text-xs sm:text-sm text-foreground-secondary leading-relaxed">{item.answer}</p>
        </div>
      ))}
    </div>
  </section>
)}
