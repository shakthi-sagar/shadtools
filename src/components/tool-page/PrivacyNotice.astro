---
export interface Props {
  mode?: 'local' | 'remote-data' | 'server-processing';
  message?: string;
}

const { mode = 'local', message } = Astro.props;
---

{mode === 'server-processing' ? (
  <div class="p-3.5 rounded-md bg-warning/10 border border-warning/30 flex items-start gap-3 text-xs leading-5 text-foreground-secondary">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mt-0.5 text-warning shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5h0a1 1 0 0 1 1 1z" />
    </svg>
    <span>{message || 'This tool uploads data for server processing. Review the privacy details before proceeding.'}</span>
  </div>
) : mode === 'remote-data' ? (
  <p class="flex items-center gap-1.5 text-xs leading-5 text-accent" title="Public data is fetched remotely; entered parameters stay local">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" />
    </svg>
    <span>{message || 'Fetches public data; entered parameters stay in your browser.'}</span>
  </p>
) : (
  <p class="flex items-center gap-1.5 text-xs leading-5 text-success" title="Data never leaves your browser">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5h0a1 1 0 0 1 1 1z" /><path d="m9 12 2 2 4-4" />
    </svg>
    <span>{message || 'Calculations stay in your browser.'}</span>
  </p>
)}
