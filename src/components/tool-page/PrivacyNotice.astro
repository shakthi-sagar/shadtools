---
export interface Props { mode?: 'local' | 'remote-data' | 'server-processing'; message?: string; }
const { mode = 'local', message } = Astro.props;
const copy = mode === 'server-processing'
  ? message || 'This tool uploads data for processing. Review the privacy disclosure before continuing.'
  : mode === 'remote-data'
    ? message || 'Uses public remote data while your entered parameters stay in this browser.'
    : message || 'Processed locally in your browser.';
---

<div class:list={[
  'inline-flex max-w-full items-center gap-2 rounded-md border px-2.5 py-1.5 text-xs',
  mode === 'server-processing' ? 'border-warning/30 bg-warning/10 text-warning' : mode === 'remote-data' ? 'border-accent/30 bg-accent-subtle text-accent' : 'border-success/30 bg-success/10 text-success',
]} title={copy}>
  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-current"></span>
  <span class="truncate">{copy}</span>
</div>
