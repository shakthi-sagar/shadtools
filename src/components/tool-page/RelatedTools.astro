---
import { getToolUrl } from '../../lib/routing';

export interface Props {
  relatedTools: string[];
}

const { relatedTools } = Astro.props;
---

{relatedTools && relatedTools.length > 0 && (
  <section class="space-y-4">
    <h2 class="text-xl font-bold text-foreground tracking-tight">Related Tools</h2>
    <div class="divide-y divide-border border-y border-border">
      {relatedTools.map((rel) => {
        const parts = rel.split('/');
        const relNs = parts[0];
        const relSlug = parts.length > 1 ? parts[1] : parts[0];
        return (
          <a
            href={getToolUrl(relNs, relSlug)}
            class="py-3 flex items-center justify-between text-sm text-foreground hover:text-accent transition-colors group"
          >
            <span class="font-medium">{rel}</span>
            <span class="text-xs text-foreground-muted group-hover:text-accent group-hover:translate-x-1 transition-all">
              →
            </span>
          </a>
        );
      })}
    </div>
  </section>
)}
