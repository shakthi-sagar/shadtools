---
export interface Props {
  relatedTools: string[];
}

const { relatedTools } = Astro.props;
---

{relatedTools && relatedTools.length > 0 && (
  <section class="space-y-4 pt-4 border-t border-slate-800">
    <h2 class="text-xl font-bold text-white">Related Tools</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      {relatedTools.map((rel) => {
        const parts = rel.split('/');
        const relNs = parts[0];
        const relSlug = parts.length > 1 ? parts[1] : parts[0];
        return (
          <a
            href={`/${relNs}/${relSlug}`}
            class="p-4 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors block space-y-1 group"
          >
            <h3 class="font-semibold text-slate-200 text-base group-hover:text-indigo-400 transition-colors">
              {rel}
            </h3>
            <span class="text-xs text-indigo-400 font-medium flex items-center gap-1">
              <span>Open tool</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </span>
          </a>
        );
      })}
    </div>
  </section>
)}
