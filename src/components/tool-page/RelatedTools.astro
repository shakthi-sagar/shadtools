---
import { getToolUrl } from '@/lib/routing';
import { resolveRelatedTools } from '@/lib/catalog/resolve-related-tools';

export interface Props {
  relatedTools: string[];
}

const { relatedTools } = Astro.props;
const resolvedTools = await resolveRelatedTools(relatedTools);
const toolsByKey = new Map(
  resolvedTools.map((tool) => [`${tool.namespace}/${tool.slug}`, tool])
);
const displayTools = relatedTools
  .map((key) => toolsByKey.get(key))
  .filter((tool): tool is NonNullable<typeof tool> => Boolean(tool));
---

{displayTools.length > 0 && (
  <section class="space-y-4">
    <div>
      <h2 class="text-xl font-semibold text-foreground">Related tools</h2>
      <p class="mt-1 text-sm text-foreground-muted">Keep working with these nearby utilities.</p>
    </div>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      {displayTools.map((tool) => (
        <a
          href={getToolUrl(tool.namespace, tool.slug)}
          class="group flex min-h-28 flex-col justify-between rounded-lg border border-border bg-surface p-4 transition-colors hover:border-border-strong hover:bg-surface-subtle"
        >
          <div>
            <span class="text-[10px] font-semibold uppercase text-accent">{tool.namespace}</span>
            <h3 class="mt-1 text-sm font-semibold text-foreground group-hover:text-accent">{tool.name}</h3>
            <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-foreground-muted">{tool.summary}</p>
          </div>
          <span class="mt-3 self-end text-xs text-foreground-muted transition-transform group-hover:translate-x-0.5 group-hover:text-accent">&rarr;</span>
        </a>
      ))}
    </div>
  </section>
)}
