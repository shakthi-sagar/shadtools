---
import type { SeoSection, SeoVariantResult } from '@/tools/tool-module';
import { getVariantUrl } from '@/lib/routing';

export interface Props {
  namespace: string;
  toolSlug: string;
  queryLabel: string;
  result: SeoVariantResult;
  sections?: SeoSection[];
  nearbyVariants?: Array<{ slug: string; label: string }>;
}

const {
  namespace,
  toolSlug,
  queryLabel,
  result,
  sections = [],
  nearbyVariants = [],
} = Astro.props;

const answerText = /[.!?]$/.test(result.answer) ? result.answer : `${result.answer}.`;
const contentSections = sections.filter(
  (section) => section.type !== 'links' && section.title.toLowerCase() !== 'how to convert'
);
---

<div class="space-y-10">
  <section>
    <h2 class="text-2xl font-semibold text-foreground tracking-[-0.028em]">
      How to convert {queryLabel}
    </h2>
    <p class="mt-3 text-base leading-7 text-foreground-secondary">
      <strong class="font-semibold text-accent">{answerText}</strong>
      {result.formula && <span> Use the conversion factor: {result.formula}.</span>}
    </p>
    {result.steps && (
      <div class="mt-4 pl-4 py-1 border-l-2 border-accent text-[13px] leading-6 font-mono text-foreground">
        {result.steps}
      </div>
    )}
  </section>

  {contentSections.map((section) => (
    <section class="pt-8 border-t border-border space-y-4">
      <h2 class="text-2xl font-semibold text-foreground tracking-[-0.028em]">{section.title}</h2>

      {section.type === 'cards' && section.cards && (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {section.cards.map((card) => (
            <div class="p-4 rounded-lg bg-surface border border-border space-y-1.5">
              <span class="text-[11px] font-semibold text-foreground-muted uppercase tracking-[0.08em]">
                {card.label}
              </span>
              <p class="text-[13px] leading-6 text-foreground font-mono">{card.value}</p>
            </div>
          ))}
        </div>
      )}

      {section.type === 'table' && section.table && (
        <div class="overflow-x-auto border border-border rounded-lg">
          <table class="w-full text-[13px] text-left">
            <thead class="bg-surface-subtle border-b border-border text-foreground-muted">
              <tr>
                <th class="px-4 py-3 font-semibold">{section.table.headers[0]}</th>
                <th class="px-4 py-3 font-semibold">{section.table.headers[1]}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border bg-surface font-mono tabular-nums">
              {section.table.rows.map((row) => (
                <tr class={row.isCurrent ? 'bg-accent/10 text-accent' : 'hover:bg-surface-subtle'}>
                  <td class="px-4 py-3">
                    {row.slug ? (
                      <a
                        href={getVariantUrl(namespace, toolSlug, row.slug)}
                        class="font-medium text-foreground hover:text-accent transition-colors"
                      >
                        {row.from}
                      </a>
                    ) : (
                      <span>{row.from}</span>
                    )}
                  </td>
                  <td class="px-4 py-3 text-foreground-secondary">{row.to}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {section.type === 'text' && section.text && (
        <p class="text-base leading-7 text-foreground-secondary">{section.text}</p>
      )}
    </section>
  ))}

  {contentSections.length === 0 && nearbyVariants.length > 0 && (
    <section class="pt-8 border-t border-border space-y-4">
      <h2 class="text-2xl font-semibold text-foreground tracking-[-0.028em]">Nearby conversions</h2>
      <div class="flex flex-wrap gap-2">
        {nearbyVariants.map((nearbyVariant) => (
          <a
            href={getVariantUrl(namespace, toolSlug, nearbyVariant.slug)}
            class="px-3 py-2 rounded-md bg-surface border border-border hover:border-border-strong text-[13px] text-foreground-secondary hover:text-foreground transition-colors"
          >
            {nearbyVariant.label}
          </a>
        ))}
      </div>
    </section>
  )}
</div>
