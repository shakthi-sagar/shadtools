---
export interface Props {
  name: string;
  summary: string;
}

const { name, summary } = Astro.props;
---

<div class="space-y-2">
  <h1 class="text-[2rem] leading-[1.12] sm:text-[2.375rem] font-semibold text-foreground tracking-[-0.035em]">{name}</h1>
  <p class="text-[0.9375rem] sm:text-base text-foreground-secondary max-w-[720px] leading-7">{summary}</p>
</div>
