---
export interface Props {
  name: string;
  summary: string;
}

const { name, summary } = Astro.props;
---

<div class="space-y-1.5">
  <h1 class="text-2xl sm:text-3xl font-semibold text-foreground tracking-tight">{name}</h1>
  <p class="text-sm sm:text-base text-foreground-secondary max-w-3xl leading-relaxed">{summary}</p>
</div>
