---
import MetaHead from '../components/seo/MetaHead.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { SearchCommand } from '../components/site/SearchCommand';
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolSlug, getToolUrl } from '../lib/routing';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  keywords?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  keywords,
  noindex,
} = Astro.props;

const allToolsCollection = await getCollection('tools');
const commandTools = allToolsCollection
  .filter((e) => e.data.status === 'published')
  .map((e) => {
    const ns = getNamespaceSlug(e);
    const sl = getToolSlug(e);
    return {
      id: e.data.id || `${ns}/${sl}`,
      name: e.data.name,
      namespace: ns,
      summary: e.data.summary,
      url: getToolUrl(ns, sl),
      searchWeight: e.data.searchWeight || 1,
    };
  });
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
    <MetaHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      keywords={keywords}
      noindex={noindex}
    />
  </head>
  <body class="flex flex-col min-h-screen bg-background text-foreground selection:bg-accent-subtle selection:text-accent">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
    <!-- Global Command Search Island (Ctrl+K / ⌘K) -->
    <SearchCommand client:load tools={commandTools} />
  </body>
</html>
