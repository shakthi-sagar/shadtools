---
import MetaHead from '../components/seo/MetaHead.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  keywords?: string[];
  noindex?: boolean;
  categoryClass?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogImage,
  keywords,
  noindex,
  categoryClass = 'category-documents'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class={`dark ${categoryClass}`}>
  <head>
    <MetaHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      keywords={keywords}
      noindex={noindex}
    />
  </head>
  <body class="flex flex-col min-h-screen">
    <Header />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
