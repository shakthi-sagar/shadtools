---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  breadcrumbs: Array<{ name: string; url: string }>;
}

const { title, description, canonicalUrl, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <Breadcrumbs items={breadcrumbs} />
    <slot />
  </div>
</BaseLayout>
