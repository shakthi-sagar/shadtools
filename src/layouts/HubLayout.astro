---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  breadcrumbs: Array<{ name: string; url: string }>;
}

const { title, description, canonicalUrl, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl}>
  <div class="mx-auto max-w-[1040px] space-y-8 px-4 py-6 sm:px-6 sm:py-9">
    <Breadcrumbs items={breadcrumbs} />
    <slot />
  </div>
</BaseLayout>
