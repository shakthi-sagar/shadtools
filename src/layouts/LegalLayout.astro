---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  updatedAt?: string;
}

const { title, description, canonicalUrl, updatedAt = 'August 7, 2026' } = Astro.props;

const breadcrumbItems = [
  { name: title.replace(' - ShadTools', ''), url: canonicalUrl },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
>
  <div class="mx-auto max-w-[760px] space-y-6 px-4 py-6 sm:px-6 sm:py-9">
    <Breadcrumbs items={breadcrumbItems} />

    <div class="space-y-1.5 border-b border-border pb-4">
      <h1 class="text-2xl sm:text-3xl font-semibold text-foreground tracking-tight">
        {title.replace(' - ShadTools', '')}
      </h1>
      <p class="text-xs text-foreground-muted">
        Last updated: {updatedAt}
      </p>
    </div>

    <div class="prose max-w-none">
      <slot />
    </div>
  </div>
</BaseLayout>
