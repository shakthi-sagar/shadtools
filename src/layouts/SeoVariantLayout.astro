---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import AdSlot from '@/components/tool-page/AdSlot.astro';
import type { SeoVariantMetadata, SeoVariantResult, SeoSection, BreadcrumbParent } from '@/tools/tool-module';
import { getVariantUrl, getToolUrl, getNamespaceUrl } from '@/lib/routing';

export interface Props {
  namespace: string;
  toolSlug: string;
  toolName: string;
  variant: string;
  meta: SeoVariantMetadata;
  result: SeoVariantResult;
  noindex: boolean;
  breadcrumbParent?: BreadcrumbParent | null;
  sections?: SeoSection[];
  nearbyVariants?: Array<{ slug: string; label: string }>;
  privacyMessage?: string;
}

const {
  namespace, toolSlug, toolName, variant, meta, result, noindex, breadcrumbParent,
  sections, nearbyVariants = [], privacyMessage = 'Processed locally in your browser.',
} = Astro.props;

const canonicalUrl = `https://shadtools.com${getVariantUrl(namespace, toolSlug, variant)}`;
const nsLabel = namespace.charAt(0).toUpperCase() + namespace.slice(1);
const breadcrumbItems = [
  { name: nsLabel, url: getNamespaceUrl(namespace) },
  { name: toolName, url: getToolUrl(namespace, toolSlug) },
];
if (breadcrumbParent) breadcrumbItems.push({ name: breadcrumbParent.name, url: getVariantUrl(namespace, toolSlug, breadcrumbParent.slug) });
breadcrumbItems.push({ name: meta.h1, url: getVariantUrl(namespace, toolSlug, variant) });

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem', position: index + 1, name: item.name, item: `https://shadtools.com${item.url}`,
  })),
};
---

<BaseLayout title={meta.title} description={meta.description} canonicalUrl={canonicalUrl} noindex={noindex}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="mx-auto max-w-[1180px] px-4 py-6 sm:px-6 sm:py-8" data-pagefind-ignore>
    <Breadcrumbs items={breadcrumbItems} />

    <div class="mb-6 mt-5">
      <p class="mb-2 text-xs font-semibold uppercase text-accent">Instant conversion</p>
      <h1 class="max-w-4xl text-2xl font-semibold leading-tight text-foreground sm:text-3xl">{meta.h1}</h1>
      <div class="mt-5 overflow-hidden rounded-lg border border-border bg-surface">
        <div class="border-b border-border bg-surface-subtle px-4 py-2 text-[10px] font-semibold uppercase text-foreground-muted">Answer</div>
        <div class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
          <p class="break-words font-mono text-xl font-semibold text-foreground sm:text-2xl">{result.answer}</p>
          <span class="inline-flex shrink-0 items-center gap-2 text-xs text-success">
            <span class="h-1.5 w-1.5 rounded-full bg-current"></span>{privacyMessage}
          </span>
        </div>
      </div>
    </div>

    <section aria-label={`${toolName} converter`}><slot name="tool" /></section>

    <div class="mt-12 grid items-start gap-10 lg:grid-cols-[minmax(0,760px)_280px] lg:justify-between">
      <div class="space-y-9">
        {sections?.length ? sections.map((section) => (
          <section class="border-t border-border pt-7 first:border-t-0 first:pt-0">
            <h2 class="mb-4 text-lg font-semibold text-foreground">{section.title}</h2>
            {section.type === 'cards' && section.cards && (
              <div class="grid overflow-hidden rounded-lg border border-border bg-surface sm:grid-cols-2">
                {section.cards.map((card) => (
                  <div class="border-b border-border p-4 last:border-b-0 sm:border-r">
                    <span class="text-[10px] font-semibold uppercase text-foreground-muted">{card.label}</span>
                    <p class="mt-1.5 break-words font-mono text-sm text-foreground">{card.value}</p>
                  </div>
                ))}
              </div>
            )}
            {section.type === 'table' && section.table && (
              <div class="overflow-x-auto rounded-lg border border-border">
                <table class="w-full text-left text-sm">
                  <thead class="border-b border-border bg-surface-subtle text-xs text-foreground-muted">
                    <tr><th class="px-4 py-3 font-medium">{section.table.headers[0]}</th><th class="px-4 py-3 font-medium">{section.table.headers[1]}</th></tr>
                  </thead>
                  <tbody class="divide-y divide-border bg-surface font-mono text-xs">
                    {section.table.rows.map((row) => (
                      <tr class={row.isCurrent ? 'bg-accent-subtle text-accent' : 'hover:bg-surface-subtle'}>
                        <td class="px-4 py-3">{row.slug ? <a href={getVariantUrl(namespace, toolSlug, row.slug)} class="font-medium hover:underline">{row.from}</a> : row.from}</td>
                        <td class="px-4 py-3 text-foreground-secondary">{row.to}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {section.type === 'text' && section.text && <p class="text-sm leading-7 text-foreground-secondary">{section.text}</p>}
            {section.type === 'links' && section.links && (
              <div class="flex flex-wrap gap-2">
                {section.links.map((link) => <a href={getVariantUrl(namespace, toolSlug, link.slug)} class="rounded-md border border-border bg-surface px-3 py-2 text-xs text-foreground-secondary hover:border-border-strong hover:text-foreground">{link.label}</a>)}
              </div>
            )}
          </section>
        )) : (
          <>
            {(result.formula || result.steps) && (
              <section>
                <h2 class="mb-4 text-lg font-semibold text-foreground">How to convert</h2>
                <div class="divide-y divide-border overflow-hidden rounded-lg border border-border bg-surface">
                  {result.formula && <div class="p-4"><span class="text-[10px] font-semibold uppercase text-foreground-muted">Formula</span><p class="mt-1.5 font-mono text-sm text-foreground">{result.formula}</p></div>}
                  {result.steps && <div class="p-4"><span class="text-[10px] font-semibold uppercase text-foreground-muted">Calculation</span><p class="mt-1.5 font-mono text-sm text-accent">{result.steps}</p></div>}
                </div>
              </section>
            )}
          </>
        )}
      </div>

      <aside class="space-y-6 lg:sticky lg:top-24">
        <div>
          <h2 class="mb-3 text-xs font-semibold uppercase text-foreground-muted">Keep converting</h2>
          <a href={getToolUrl(namespace, toolSlug)} class="flex items-center justify-between rounded-lg border border-border bg-surface px-3.5 py-3 text-sm font-medium text-foreground hover:border-border-strong hover:text-accent">
            Open {toolName}<span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        {nearbyVariants.length > 0 && (
          <div>
            <h2 class="mb-3 text-xs font-semibold uppercase text-foreground-muted">Similar conversions</h2>
            <div class="divide-y divide-border overflow-hidden rounded-lg border border-border bg-surface">
              {nearbyVariants.slice(0, 8).map((nearby) => <a href={getVariantUrl(namespace, toolSlug, nearby.slug)} class="block px-3.5 py-2.5 text-xs text-foreground-secondary hover:bg-surface-subtle hover:text-accent">{nearby.label}</a>)}
            </div>
          </div>
        )}
        <AdSlot slotId="seo-rail" />
      </aside>
    </div>
  </div>
</BaseLayout>
