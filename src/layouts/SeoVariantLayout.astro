---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import type { SeoVariantMetadata, SeoVariantResult, SeoSection, BreadcrumbParent } from '@/tools/tool-module';
import { getVariantUrl, getToolUrl, getNamespaceUrl } from '@/lib/routing';

export interface Props {
  namespace: string;
  toolSlug: string;
  toolName: string;
  variant: string;
  meta: SeoVariantMetadata;
  result: SeoVariantResult;
  noindex: boolean;
  breadcrumbParent?: BreadcrumbParent | null;
  sections?: SeoSection[];
  nearbyVariants?: Array<{ slug: string; label: string }>;
  privacyMessage?: string;
}

const {
  namespace,
  toolSlug,
  toolName,
  variant,
  meta,
  result,
  noindex,
  breadcrumbParent,
  sections,
  nearbyVariants = [],
  privacyMessage = 'Processed 100% locally in your browser.',
} = Astro.props;

const canonicalUrl = `https://shadtools.com${getVariantUrl(namespace, toolSlug, variant)}`;
const nsLabel = namespace.charAt(0).toUpperCase() + namespace.slice(1);

const breadcrumbItems = [
  { name: nsLabel, url: getNamespaceUrl(namespace) },
  { name: toolName, url: getToolUrl(namespace, toolSlug) },
];

if (breadcrumbParent) {
  breadcrumbItems.push({
    name: breadcrumbParent.name,
    url: getVariantUrl(namespace, toolSlug, breadcrumbParent.slug),
  });
}

breadcrumbItems.push({
  name: meta.h1,
  url: getVariantUrl(namespace, toolSlug, variant),
});

// JSON-LD Breadcrumb Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: `https://shadtools.com${item.url}`,
  })),
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: meta.h1,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonicalUrl={canonicalUrl}
  noindex={noindex}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-6 space-y-6" data-pagefind-ignore>
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- H1 & Direct Answer -->
    <header class="space-y-3">
      <h1 class="text-2xl sm:text-3xl font-semibold text-foreground tracking-tight">
        {meta.h1}
      </h1>

      <!-- Direct Answer Card -->
      <div class="p-4 rounded-lg bg-surface border border-border">
        <p class="text-xl sm:text-2xl font-bold text-foreground tracking-tight font-mono">
          {result.answer}
        </p>
        <div class="flex items-center gap-1.5 mt-1.5 text-xs text-success font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span>{privacyMessage}</span>
        </div>
      </div>
    </header>

    <!-- Interactive Tool (pre-filled) -->
    <div class="w-full">
      <slot name="tool" />
    </div>

    <!-- Render Custom Compositional Sections if available -->
    {sections && sections.length > 0 ? (
      sections.map((section) => (
        <section class="max-w-[720px] space-y-3 border-t border-border pt-6">
          <h2 class="text-lg font-semibold text-foreground">{section.title}</h2>

          {section.type === 'cards' && section.cards && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {section.cards.map((c) => (
                <div class="p-3.5 rounded-md bg-surface border border-border space-y-1">
                  <span class="text-[11px] font-semibold text-foreground-muted uppercase tracking-wider font-sans">{c.label}</span>
                  <p class="text-xs text-foreground font-mono">{c.value}</p>
                </div>
              ))}
            </div>
          )}

          {section.type === 'table' && section.table && (
            <div class="overflow-x-auto border border-border rounded-lg">
              <table class="w-full text-xs text-left">
                <thead class="bg-surface-subtle border-b border-border text-foreground-muted uppercase tracking-wider">
                  <tr>
                    <th class="px-4 py-2.5 font-medium">{section.table.headers[0]}</th>
                    <th class="px-4 py-2.5 font-medium">{section.table.headers[1]}</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border bg-surface font-mono">
                  {section.table.rows.map((row) => (
                    <tr class={row.isCurrent ? 'bg-accent/10 font-bold text-accent' : 'hover:bg-surface-hover'}>
                      <td class="px-4 py-2">
                        {row.slug ? (
                          <a href={getVariantUrl(namespace, toolSlug, row.slug)} class="hover:underline text-foreground">
                            {row.from}
                          </a>
                        ) : (
                          <span>{row.from}</span>
                        )}
                      </td>
                      <td class="px-4 py-2 text-foreground-secondary">{row.to}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {section.type === 'text' && section.text && (
            <div class="p-4 rounded-md bg-surface border border-border text-xs text-foreground-secondary leading-relaxed">
              {section.text}
            </div>
          )}

          {section.type === 'links' && section.links && (
            <div class="flex flex-wrap gap-2">
              {section.links.map((link) => (
                <a
                  href={getVariantUrl(namespace, toolSlug, link.slug)}
                  class="px-2.5 py-1.5 rounded-md bg-surface border border-border hover:border-border-strong text-xs text-foreground-secondary hover:text-foreground transition-colors"
                >
                  {link.label}
                </a>
              ))}
            </div>
          )}
        </section>
      ))
    ) : (
      <!-- Fallback Default Layout for Tools without getSections -->
      <>
        {(result.formula || result.steps) && (
          <section class="max-w-[720px] space-y-3 border-t border-border pt-6">
            <h2 class="text-lg font-semibold text-foreground">How to Convert</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {result.formula && (
                <div class="p-3.5 rounded-md bg-surface border border-border space-y-1">
                  <span class="text-[11px] font-semibold text-foreground-muted uppercase tracking-wider font-sans">Formula</span>
                  <p class="text-xs text-foreground font-mono">{result.formula}</p>
                </div>
              )}
              {result.steps && (
                <div class="p-3.5 rounded-md bg-surface border border-border space-y-1">
                  <span class="text-[11px] font-semibold text-foreground-muted uppercase tracking-wider font-sans">Calculation</span>
                  <p class="text-xs text-accent font-mono font-bold">{result.steps}</p>
                </div>
              )}
            </div>
          </section>
        )}

        {nearbyVariants.length > 0 && (
          <section class="max-w-[720px] space-y-3 border-t border-border pt-6">
            <h2 class="text-lg font-semibold text-foreground">Similar Conversions</h2>
            <div class="flex flex-wrap gap-2">
              {nearbyVariants.map((nv) => (
                <a
                  href={getVariantUrl(namespace, toolSlug, nv.slug)}
                  class="px-2.5 py-1.5 rounded-md bg-surface border border-border hover:border-border-strong text-xs text-foreground-secondary hover:text-foreground transition-colors"
                >
                  {nv.label}
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    )}

    <!-- Ad slot -->
    <div class="p-3 rounded-md bg-surface-subtle border border-border text-center text-xs text-foreground-muted">
      <span>Advertisement</span>
    </div>

    <!-- Back link -->
    <div class="pt-2">
      <a
        href={getToolUrl(namespace, toolSlug)}
        class="inline-flex items-center gap-1.5 text-xs font-medium text-accent hover:text-accent-hover transition-colors"
      >
        <span>← Back to {toolName}</span>
      </a>
    </div>
  </div>
</BaseLayout>
