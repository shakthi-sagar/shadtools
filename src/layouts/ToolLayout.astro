---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import PrivacyNotice from '../components/common/PrivacyNotice.astro';
import AdPlaceholder from '../components/common/AdPlaceholder.astro';
import JsonLdApp from '../components/seo/JsonLdApp.astro';
import JsonLdBreadcrumb from '../components/seo/JsonLdBreadcrumb.astro';
import JsonLdFaq from '../components/seo/JsonLdFaq.astro';

export interface Props {
  tool: {
    id: string;
    name: string;
    slug: string;
    namespace: string;
    category: string;
    shortDescription: string;
    longDescription?: string;
    keywords: string[];
    primaryKeyword: string;
    examples?: Array<{ input: string; output: string; description?: string }>;
    faq?: Array<{ question: string; answer: string }>;
    relatedTools?: string[];
  };
  allTools?: any[];
}

const { tool, allTools = [] } = Astro.props;

const currentUrl = `https://shadtools.com/${tool.namespace}/${tool.slug}`;

const breadcrumbItems = [
  { name: tool.namespace.toUpperCase(), url: `/${tool.namespace}` },
  { name: tool.name, url: `/${tool.namespace}/${tool.slug}` }
];

const relatedToolsList = allTools.filter((t) => 
  t.id !== tool.id && 
  (tool.relatedTools?.includes(t.id) || t.namespace === tool.namespace)
).slice(0, 6);
---

<BaseLayout
  title={`${tool.name} - Free Online Tool`}
  description={tool.shortDescription}
  canonicalUrl={currentUrl}
  keywords={tool.keywords}
>
  <!-- JSON-LD Structured Data Injection -->
  <JsonLdApp
    name={tool.name}
    description={tool.shortDescription}
    url={currentUrl}
    category={tool.category}
  />
  <JsonLdBreadcrumb items={breadcrumbItems} />
  {tool.faq && <JsonLdFaq faq={tool.faq} />}

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    
    <!-- Top Banner Ad (Reserved CLS slot) -->
    <AdPlaceholder slot="top-banner" />

    <!-- Breadcrumb Navigation -->
    <Breadcrumb items={breadcrumbItems} />

    <!-- Tool Header & Description -->
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded text-[11px] font-mono font-semibold bg-slate-900 border border-slate-800 text-slate-300">
        <span>{tool.namespace.toUpperCase()} TOOL</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        {tool.name}
      </h1>
      <p class="text-xs sm:text-sm text-slate-400 max-w-3xl leading-relaxed">
        {tool.shortDescription}
      </p>
    </div>

    <!-- Working Interactive Tool Component (Above the Fold) -->
    <div class="p-5 sm:p-6 rounded-xl bg-slate-900 border border-slate-800 shadow-xl">
      <slot />
    </div>

    <!-- Privacy Notice -->
    <PrivacyNotice toolName={tool.name} />

    <!-- Below Tool Ad Position -->
    <AdPlaceholder slot="below-tool" />

    <!-- Instructions & How it Works -->
    {tool.longDescription && (
      <section class="p-5 rounded-xl bg-slate-900 border border-slate-800 space-y-3">
        <h2 class="text-base font-bold text-white">How {tool.name} Works</h2>
        <p class="text-slate-300 text-xs leading-relaxed whitespace-pre-line">
          {tool.longDescription}
        </p>
      </section>
    )}

    <!-- Step-by-Step Instructions -->
    <section class="p-5 rounded-xl bg-slate-900 border border-slate-800 space-y-3">
      <h2 class="text-base font-bold text-white">Step-by-Step Instructions</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-3.5 rounded-lg bg-slate-950 border border-slate-800/80 space-y-1">
          <span class="font-bold text-blue-400">1. Input Data</span>
          <p class="text-slate-400 text-[11px]">Enter your text, number, or file into the input area above.</p>
        </div>
        <div class="p-3.5 rounded-lg bg-slate-950 border border-slate-800/80 space-y-1">
          <span class="font-bold text-blue-400">2. In-Browser Process</span>
          <p class="text-slate-400 text-[11px]">Processing executes 100% locally in your browser memory.</p>
        </div>
        <div class="p-3.5 rounded-lg bg-slate-950 border border-slate-800/80 space-y-1">
          <span class="font-bold text-blue-400">3. Copy or Download</span>
          <p class="text-slate-400 text-[11px]">Copy output text to clipboard or download your processed file.</p>
        </div>
      </div>
    </section>

    <!-- Examples Section -->
    {tool.examples && tool.examples.length > 0 && (
      <section class="p-5 rounded-xl bg-slate-900 border border-slate-800 space-y-3">
        <h2 class="text-base font-bold text-white">Examples</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {tool.examples.map((ex) => (
            <div class="p-3.5 rounded-lg bg-slate-950 border border-slate-800 text-xs space-y-2">
              {ex.description && <p class="font-semibold text-slate-300">{ex.description}</p>}
              <div class="font-mono bg-slate-900 p-2 rounded text-emerald-400 overflow-x-auto text-[11px]">
                <span class="text-slate-500">In:</span> {ex.input}
              </div>
              <div class="font-mono bg-slate-900 p-2 rounded text-blue-400 overflow-x-auto text-[11px]">
                <span class="text-slate-500">Out:</span> {ex.output}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- FAQs Section -->
    {tool.faq && tool.faq.length > 0 && (
      <section class="p-5 rounded-xl bg-slate-900 border border-slate-800 space-y-4">
        <h2 class="text-base font-bold text-white">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {tool.faq.map((item) => (
            <div class="p-3.5 rounded-lg bg-slate-950 border border-slate-800 space-y-1">
              <h3 class="font-semibold text-slate-200 text-xs">{item.question}</h3>
              <p class="text-[11px] text-slate-400 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Related Tools Cross-Linking -->
    {relatedToolsList.length > 0 && (
      <section class="space-y-3 pt-2">
        <h2 class="text-base font-bold text-white">Related Tools</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          {relatedToolsList.map((rel) => (
            <a
              href={`/${rel.namespace}/${rel.slug}`}
              class="p-4 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors block space-y-1 group"
            >
              <h3 class="font-semibold text-slate-200 text-xs group-hover:text-blue-400 transition-colors">
                {rel.name}
              </h3>
              <p class="text-[11px] text-slate-400 line-clamp-2">{rel.shortDescription}</p>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</BaseLayout>
