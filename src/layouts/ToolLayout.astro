---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import PrivacyNotice from '@/components/tool-page/PrivacyNotice.astro';
import Faq from '@/components/tool-page/Faq.astro';
import RelatedTools from '@/components/tool-page/RelatedTools.astro';
import AdSlot from '@/components/tool-page/AdSlot.astro';
import WebApplicationJsonLd from '@/components/seo/WebApplicationJsonLd.astro';
import { getToolUrl, getNamespaceUrl } from '@/lib/routing';

export interface Props {
  tool: {
    id: string; name: string; namespace: string; summary: string;
    seo: { title: string; description: string; primaryKeyword: string; keywords?: string[]; noindex?: boolean };
    privacy: { processing: 'local' | 'remote-data' | 'server-processing'; message: string };
    examples?: Array<{ title?: string; input: string; output: string }>;
    faq?: Array<{ question: string; answer: string }>;
    relatedTools?: string[];
  };
  namespace: string;
  slug: string;
}

const { tool, namespace, slug } = Astro.props;
const toolId = tool.id || `${namespace}/${slug}`;
const currentUrl = `https://shadtools.com${getToolUrl(namespace, slug)}`;
const nsName = namespace.charAt(0).toUpperCase() + namespace.slice(1);
const breadcrumbItems = [
  { name: nsName, url: getNamespaceUrl(namespace) },
  { name: tool.name, url: getToolUrl(namespace, slug) },
];
---

<BaseLayout title={tool.seo.title} description={tool.seo.description} canonicalUrl={currentUrl} keywords={tool.seo.keywords} noindex={tool.seo.noindex}>
  <WebApplicationJsonLd name={tool.name} description={tool.seo.description} url={currentUrl} />
  <div class="mx-auto max-w-[1180px] px-4 py-6 sm:px-6 sm:py-8" data-pagefind-body>
    <Breadcrumbs items={breadcrumbItems} />
    <div class="mb-6 mt-5 flex flex-col gap-4 border-b border-border pb-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <p class="mb-2 text-xs font-semibold uppercase text-accent">{nsName} tool</p>
        <h1 class="text-2xl font-semibold leading-tight text-foreground sm:text-3xl">{tool.name}</h1>
        <p class="mt-2 text-sm leading-6 text-foreground-secondary sm:text-[15px]">{tool.summary}</p>
      </div>
      <PrivacyNotice mode={tool.privacy.processing} message={tool.privacy.message} />
    </div>

    <section aria-label={`${tool.name} workspace`} class="w-full"><slot name="tool" /></section>
    <div class="mt-8"><AdSlot slotId={`${namespace}-${slug}`} /></div>

    <div class="mt-12 grid items-start gap-12 lg:grid-cols-[minmax(0,760px)_280px] lg:justify-between">
      <div class="space-y-12">
        <section class="prose max-w-none"><slot name="content" /></section>
        {tool.faq?.length && <Faq faq={tool.faq} />}
      </div>
      {tool.relatedTools?.length && <aside class="lg:sticky lg:top-24"><RelatedTools relatedTools={tool.relatedTools} /></aside>}
    </div>
  </div>

  <script is:inline define:vars={{ toolId }}>
    (function() {
      if (!toolId) return;
      try {
        const key = 'shadtools.dashboard.v1';
        const raw = localStorage.getItem(key);
        let state = { version: 1, pinnedToolIds: [], recentToolIds: [] };
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.version === 1) state = parsed;
        }
        state.recentToolIds = [toolId, ...state.recentToolIds.filter((id) => id !== toolId)].slice(0, 8);
        localStorage.setItem(key, JSON.stringify(state));
      } catch {}
    })();
  </script>
</BaseLayout>
