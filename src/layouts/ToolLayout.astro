---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import { getToolUrl, getNamespaceUrl } from '../lib/routing';

export interface Props {
  tool: {
    id: string;
    name: string;
    namespace: string;
    summary: string;
    seo: {
      title: string;
      description: string;
      primaryKeyword: string;
      keywords?: string[];
      noindex?: boolean;
    };
    privacy: {
      processing: 'local' | 'remote-data' | 'server-processing';
      message: string;
    };
    examples?: Array<{ title?: string; input: string; output: string }>;
    faq?: Array<{ question: string; answer: string }>;
    relatedTools?: string[];
  };
  namespace: string;
  slug: string;
}

const { tool, namespace, slug } = Astro.props;

const currentUrl = `https://shadtools.com${getToolUrl(namespace, slug)}`;
const nsName = namespace.charAt(0).toUpperCase() + namespace.slice(1);

const breadcrumbItems = [
  { name: nsName, url: getNamespaceUrl(namespace) },
  { name: tool.name, url: getToolUrl(namespace, slug) },
];
---

<BaseLayout
  title={tool.seo.title}
  description={tool.seo.description}
  canonicalUrl={currentUrl}
  keywords={tool.seo.keywords}
  noindex={tool.seo.noindex}
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-6 space-y-6" data-pagefind-body>
    <!-- Breadcrumb Navigation -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Tool Header & Privacy Line -->
    <div class="space-y-1.5">
      <h1 class="text-2xl sm:text-3xl font-semibold text-foreground tracking-tight">
        {tool.name}
      </h1>
      <p class="text-sm text-foreground-secondary leading-relaxed max-w-3xl">
        {tool.summary}
      </p>
      {tool.privacy.processing === 'local' ? (
        <div class="flex items-center gap-1.5 text-xs text-success font-medium pt-0.5" title="Data never leaves your browser">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          <span>{tool.privacy.message || 'Processed 100% locally in your browser tab'}</span>
        </div>
      ) : (
        <div class="flex items-center gap-1.5 text-xs text-foreground-secondary font-medium pt-0.5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-foreground-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19c2.5 0 4.5-2 4.5-4.5 0-2.3-1.7-4.2-3.9-4.5-1-2.6-3.5-4.5-6.6-4.5-3.6 0-6.6 2.5-7.3 6-2.2.4-3.7 2.3-3.7 4.5 0 2.5 2 4.5 4.5 4.5h12.5z"/></svg>
          <span>{tool.privacy.message || 'Fetches public data · entered parameters remain local'}</span>
        </div>
      )}
    </div>

    <!-- Working Interactive Tool Component Slot -->
    <div class="w-full">
      <slot name="tool" />
    </div>

    <!-- Below Tool Ad Position -->
    <div class="py-2">
      <div class="p-3 rounded-md bg-surface-subtle border border-border text-center text-xs text-foreground-muted">
        <span>Advertisement</span>
      </div>
    </div>

    <!-- Rendered Markdown Content Slot -->
    <section class="prose max-w-[720px] pt-2">
      <slot name="content" />
    </section>

    <!-- Examples Section -->
    {tool.examples && tool.examples.length > 0 && (
      <section class="max-w-[720px] space-y-3 pt-6 border-t border-border">
        <h2 class="text-lg font-semibold text-foreground">Examples</h2>
        <div class="space-y-3">
          {tool.examples.map((ex) => (
            <div class="p-3.5 rounded-md bg-surface border border-border text-xs space-y-2">
              {ex.title && <p class="font-medium text-foreground">{ex.title}</p>}
              <div class="font-mono bg-surface-subtle p-2.5 rounded border border-border text-foreground-secondary overflow-x-auto">
                <span class="text-foreground-muted select-none">In: </span>{ex.input}
              </div>
              <div class="font-mono bg-surface-subtle p-2.5 rounded border border-border text-accent overflow-x-auto">
                <span class="text-foreground-muted select-none">Out: </span>{ex.output}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- FAQs Section -->
    {tool.faq && tool.faq.length > 0 && (
      <section class="max-w-[720px] space-y-3 pt-6 border-t border-border">
        <h2 class="text-lg font-semibold text-foreground">Frequently Asked Questions</h2>
        <div class="divide-y divide-border border-y border-border">
          {tool.faq.map((item) => (
            <details class="group py-3 cursor-pointer">
              <summary class="flex items-center justify-between font-medium text-sm text-foreground list-none select-none">
                <span>{item.question}</span>
                <span class="text-foreground-muted group-open:rotate-45 transition-transform text-lg leading-none">+</span>
              </summary>
              <p class="mt-2 text-xs text-foreground-secondary leading-relaxed">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related Tools Cross-Linking -->
    {tool.relatedTools && tool.relatedTools.length > 0 && (
      <section class="max-w-[720px] space-y-3 pt-6 border-t border-border">
        <h2 class="text-lg font-semibold text-foreground">Related Tools</h2>
        <div class="divide-y divide-border border-y border-border">
          {tool.relatedTools.map((rel) => {
            const [relNs, relSlug] = rel.split('/');
            return (
              <a
                href={getToolUrl(relNs, relSlug)}
                class="py-2.5 flex items-center justify-between text-sm text-foreground hover:text-accent transition-colors group"
              >
                <span class="font-medium">{rel}</span>
                <span class="text-xs text-foreground-muted group-hover:text-accent transition-colors">→</span>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
