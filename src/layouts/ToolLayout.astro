---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import ToolHeader from '@/components/tool-page/ToolHeader.astro';
import PrivacyNotice from '@/components/tool-page/PrivacyNotice.astro';
import Faq from '@/components/tool-page/Faq.astro';
import RelatedTools from '@/components/tool-page/RelatedTools.astro';
import SeoVariantContent from '@/components/tool-page/SeoVariantContent.astro';
import SeoVariantLinks from '@/components/tool-page/SeoVariantLinks.astro';
import AdSlot from '@/components/tool-page/AdSlot.astro';
import WebApplicationJsonLd from '@/components/seo/WebApplicationJsonLd.astro';
import type { BreadcrumbParent, SeoSection, SeoVariantMetadata, SeoVariantResult } from '@/tools/tool-module';
import { getToolUrl, getNamespaceUrl, getVariantUrl } from '@/lib/routing';

interface SeoVariantPage {
  slug: string;
  meta: SeoVariantMetadata;
  result: SeoVariantResult;
  noindex: boolean;
  breadcrumbParent?: BreadcrumbParent | null;
  sections?: SeoSection[];
  nearbyVariants?: Array<{ slug: string; label: string }>;
}

export interface Props {
  tool: {
    id: string;
    name: string;
    namespace: string;
    pattern: 'code-editor' | 'file' | 'calculator' | 'converter' | 'generator';
    summary: string;
    seo: {
      title: string;
      description: string;
      primaryKeyword: string;
      keywords?: string[];
      noindex?: boolean;
    };
    privacy: {
      processing: 'local' | 'remote-data' | 'server-processing';
      message: string;
    };
    examples?: Array<{ title?: string; input: string; output: string }>;
    faq?: Array<{ question: string; answer: string }>;
    relatedTools?: string[];
  };
  namespace: string;
  slug: string;
  seoVariant?: SeoVariantPage;
}

const { tool, namespace, slug, seoVariant } = Astro.props;

const toolId = tool.id || `${namespace}/${slug}`;
const isSeoVariant = Boolean(seoVariant);
const currentPath = seoVariant
  ? getVariantUrl(namespace, slug, seoVariant.slug)
  : getToolUrl(namespace, slug);
const currentUrl = `https://shadtools.com${currentPath}`;
const nsName = namespace.charAt(0).toUpperCase() + namespace.slice(1);
const pageTitle = seoVariant?.meta.title || tool.seo.title;
const pageDescription = seoVariant?.meta.description || tool.seo.description;
const pageHeading = seoVariant?.meta.h1 || tool.name;
const queryLabel = seoVariant?.meta.h1.replace(/\s+Converter$/i, '') || '';
const pageSummary = seoVariant
  ? `Convert ${queryLabel} with an editable calculator, clear formula, and nearby values.`
  : tool.summary;
const showPrivacyNotice = tool.pattern !== 'converter' && tool.pattern !== 'calculator';

const breadcrumbItems = [
  { name: nsName, url: getNamespaceUrl(namespace) },
  { name: tool.name, url: getToolUrl(namespace, slug) },
];

if (seoVariant?.breadcrumbParent) {
  breadcrumbItems.push({
    name: seoVariant.breadcrumbParent.name,
    url: getVariantUrl(namespace, slug, seoVariant.breadcrumbParent.slug),
  });
}

if (seoVariant) {
  breadcrumbItems.push({
    name: seoVariant.meta.h1,
    url: currentPath,
  });
}

const breadcrumbSchema = seoVariant
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: `https://shadtools.com${item.url}`,
      })),
    }
  : null;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={currentUrl}
  keywords={tool.seo.keywords}
  noindex={seoVariant?.noindex ?? tool.seo.noindex}
>
  <WebApplicationJsonLd name={pageHeading} description={pageDescription} url={currentUrl} />
  {breadcrumbSchema && (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  )}

  <div
    class="max-w-[1120px] mx-auto px-4 sm:px-6 py-7 sm:py-8"
    data-pagefind-body={!isSeoVariant || undefined}
    data-pagefind-ignore={isSeoVariant || undefined}
  >
    <header class="space-y-3">
      <Breadcrumbs items={breadcrumbItems} />
      <ToolHeader name={pageHeading} summary={pageSummary} />
      {showPrivacyNotice && (
        <PrivacyNotice mode={tool.privacy.processing} message={tool.privacy.message} />
      )}
    </header>

    <div class="mt-7 w-full">
      <slot name="tool" />
    </div>

    <div class="mt-8">
      <AdSlot />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,720px)_260px] gap-10 lg:gap-12 items-start mt-12">
      <div class="min-w-0 space-y-12">
        {seoVariant ? (
          <SeoVariantContent
            namespace={namespace}
            toolSlug={slug}
            queryLabel={queryLabel}
            result={seoVariant.result}
            sections={seoVariant.sections}
            nearbyVariants={seoVariant.nearbyVariants}
          />
        ) : (
          <section class="prose">
            <slot name="content" />
          </section>
        )}

        {tool.faq && tool.faq.length > 0 && (
          <Faq faq={tool.faq} />
        )}
      </div>

      {(isSeoVariant || (tool.relatedTools && tool.relatedTools.length > 0)) && (
        <aside class="lg:sticky lg:top-24">
          <div class="space-y-8">
            {seoVariant && (
              <SeoVariantLinks
                namespace={namespace}
                toolSlug={slug}
                toolName={tool.name}
                sections={seoVariant.sections}
              />
            )}
            {tool.relatedTools && tool.relatedTools.length > 0 && (
              <RelatedTools relatedTools={tool.relatedTools} />
            )}
          </div>
        </aside>
      )}
    </div>
  </div>

  <script is:inline define:vars={{ toolId }}>
    (function() {
      if (typeof window === 'undefined' || !toolId) return;
      try {
        const KEY = 'shadtools.dashboard.v1';
        const raw = localStorage.getItem(KEY);
        let state = { version: 1, pinnedToolIds: [], recentToolIds: [] };
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.version === 1) state = parsed;
        }
        state.recentToolIds = [toolId, ...state.recentToolIds.filter((id) => id !== toolId)].slice(0, 8);
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch (e) {
        // Storage unavailable or disabled
      }
    })();
  </script>
</BaseLayout>
