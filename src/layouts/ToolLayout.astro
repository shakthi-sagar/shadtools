---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import ToolHeader from '../components/tool-page/ToolHeader.astro';
import PrivacyNotice from '../components/tool-page/PrivacyNotice.astro';
import Faq from '../components/tool-page/Faq.astro';
import RelatedTools from '../components/tool-page/RelatedTools.astro';
import AdSlot from '../components/tool-page/AdSlot.astro';
import { getToolUrl, getNamespaceUrl } from '../lib/routing';

export interface Props {
  tool: {
    id: string;
    name: string;
    namespace: string;
    summary: string;
    seo: {
      title: string;
      description: string;
      primaryKeyword: string;
      keywords?: string[];
      noindex?: boolean;
    };
    privacy: {
      processing: 'local' | 'remote-data' | 'server-processing';
      message: string;
    };
    examples?: Array<{ title?: string; input: string; output: string }>;
    faq?: Array<{ question: string; answer: string }>;
    relatedTools?: string[];
  };
  namespace: string;
  slug: string;
}

const { tool, namespace, slug } = Astro.props;

const toolId = tool.id || `${namespace}/${slug}`;
const currentUrl = `https://shadtools.com${getToolUrl(namespace, slug)}`;
const nsName = namespace.charAt(0).toUpperCase() + namespace.slice(1);

const breadcrumbItems = [
  { name: nsName, url: getNamespaceUrl(namespace) },
  { name: tool.name, url: getToolUrl(namespace, slug) },
];
---

<BaseLayout
  title={tool.seo.title}
  description={tool.seo.description}
  canonicalUrl={currentUrl}
  keywords={tool.seo.keywords}
  noindex={tool.seo.noindex}
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-6" data-pagefind-body>
    <!-- Header Section with Hierarchical 8px Spacing -->
    <div class="space-y-2">
      <Breadcrumbs items={breadcrumbItems} />
      <ToolHeader name={tool.name} summary={tool.summary} />
      <PrivacyNotice mode={tool.privacy.processing} message={tool.privacy.message} />
    </div>

    <!-- 24px Gap Before Working Interactive Tool -->
    <div class="mt-6 w-full">
      <slot name="tool" />
    </div>

    <!-- 32px Gap After Tool Workspace -->
    <div class="mt-8">
      <AdSlot />
    </div>

    <!-- Left-Aligned 720px Reading Column (Flush with Left Grid Margin) -->
    <div class="max-w-[720px] mt-12 space-y-12">
      <!-- Rendered Markdown Content / Documentation -->
      <section class="prose">
        <slot name="content" />
      </section>

      <!-- FAQ Section -->
      {tool.faq && tool.faq.length > 0 && (
        <Faq faq={tool.faq} />
      )}

      <!-- Related Tools Section -->
      {tool.relatedTools && tool.relatedTools.length > 0 && (
        <RelatedTools relatedTools={tool.relatedTools} />
      )}
    </div>
  </div>

  <!-- Client-side script to record tool visit in localStorage recents -->
  <script is:inline define:vars={{ toolId }}>
    (function() {
      if (typeof window === 'undefined' || !toolId) return;
      try {
        const KEY = 'shadtools.dashboard.v1';
        const raw = localStorage.getItem(KEY);
        let state = { version: 1, pinnedToolIds: [], recentToolIds: [] };
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.version === 1) state = parsed;
        }
        state.recentToolIds = [toolId, ...state.recentToolIds.filter((id) => id !== toolId)].slice(0, 8);
        localStorage.setItem(KEY, JSON.stringify(state));
      } catch (e) {
        // Storage unavailable or disabled
      }
    })();
  </script>
</BaseLayout>
