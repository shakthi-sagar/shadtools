---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';

export interface Props {
  tool: {
    id: string;
    name: string;
    namespace: string;
    summary: string;
    seo: {
      title: string;
      description: string;
      primaryKeyword: string;
      keywords?: string[];
      noindex?: boolean;
    };
    privacy: {
      processing: 'local' | 'remote-data' | 'server-processing';
      message: string;
    };
    examples?: Array<{ title?: string; input: string; output: string }>;
    faq?: Array<{ question: string; answer: string }>;
    relatedTools?: string[];
  };
  namespace: string;
  slug: string;
}

const { tool, namespace, slug } = Astro.props;

const currentUrl = `https://shadtools.com/${namespace}/${slug}`;

const breadcrumbItems = [
  { name: namespace.charAt(0).toUpperCase() + namespace.slice(1), url: `/${namespace}` },
  { name: tool.name, url: `/${namespace}/${slug}` },
];
---

<BaseLayout
  title={tool.seo.title}
  description={tool.seo.description}
  canonicalUrl={currentUrl}
  keywords={tool.seo.keywords}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Breadcrumb Navigation -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Tool Header & Description -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-semibold bg-slate-900 border border-slate-800 text-indigo-300">
        <span>Online Utility</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        {tool.name}
      </h1>
      <p class="text-base text-slate-300 max-w-3xl leading-relaxed">
        {tool.summary}
      </p>
      <div class="flex items-center gap-2 pt-1 text-xs text-emerald-400 font-medium">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>{tool.privacy.message}</span>
      </div>
    </div>

    <!-- Working Interactive Tool Component Slot (Above the Fold) -->
    <div class="p-4 sm:p-6 rounded-2xl bg-slate-900/90 border border-slate-800 shadow-2xl">
      <slot name="tool" />
    </div>

    <!-- Below Tool Ad Position -->
    <div class="p-4 rounded-xl bg-slate-900/30 border border-slate-800/60 text-center text-xs text-slate-500">
      <span>Advertisement</span>
    </div>

    <!-- Rendered Markdown Content Slot -->
    <section class="prose prose-invert max-w-none prose-p:text-slate-300 prose-p:text-base prose-headings:text-white pt-4">
      <slot name="content" />
    </section>

    <!-- Examples Section -->
    {tool.examples && tool.examples.length > 0 && (
      <section class="space-y-4 pt-4 border-t border-slate-800">
        <h2 class="text-xl font-bold text-white">Examples</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {tool.examples.map((ex) => (
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 text-sm space-y-2">
              {ex.title && <p class="font-semibold text-slate-200">{ex.title}</p>}
              <div class="font-mono bg-slate-950 p-3 rounded-lg text-emerald-400 overflow-x-auto text-xs">
                <span class="text-slate-500 select-none">In: </span>{ex.input}
              </div>
              <div class="font-mono bg-slate-950 p-3 rounded-lg text-indigo-300 overflow-x-auto text-xs">
                <span class="text-slate-500 select-none">Out: </span>{ex.output}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- FAQs Section -->
    {tool.faq && tool.faq.length > 0 && (
      <section class="space-y-4 pt-4 border-t border-slate-800">
        <h2 class="text-xl font-bold text-white">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {tool.faq.map((item) => (
            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 space-y-1.5">
              <h3 class="font-semibold text-slate-100 text-base">{item.question}</h3>
              <p class="text-sm text-slate-300 leading-relaxed">{item.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Related Tools Cross-Linking -->
    {tool.relatedTools && tool.relatedTools.length > 0 && (
      <section class="space-y-4 pt-4 border-t border-slate-800">
        <h2 class="text-xl font-bold text-white">Related Tools</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {tool.relatedTools.map((rel) => {
            const [relNs, relSlug] = rel.split('/');
            return (
              <a
                href={`/${relNs}/${relSlug}`}
                class="p-4 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors block space-y-1 group"
              >
                <h3 class="font-semibold text-slate-200 text-base group-hover:text-indigo-400 transition-colors">
                  {rel}
                </h3>
                <span class="text-xs text-indigo-400 font-medium flex items-center gap-1">
                  <span>Open tool</span>
                  <span class="group-hover:translate-x-1 transition-transform">→</span>
                </span>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
