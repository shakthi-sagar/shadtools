---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button } from '../components/ui/Button';
---

<BaseLayout
  title="404 Page Not Found - ShadTools"
  description="The requested utility tool or page could not be found."
  noindex={true}
>
  <div class="max-w-md mx-auto my-20 p-8 text-center space-y-4 rounded-lg bg-surface border border-border">
    <div class="w-14 h-14 rounded-md bg-danger/10 text-danger mx-auto flex items-center justify-center font-bold text-xl">
      404
    </div>
    <h1 class="text-2xl font-bold text-foreground">Tool Page Not Found</h1>
    <p class="text-xs text-foreground-secondary leading-relaxed">
      The utility page you are looking for may have been moved or does not exist.
    </p>
    <div class="pt-2">
      <a href="/">
        <Button variant="primary" size="md">
          Return to Homepage
        </Button>
      </a>
    </div>
  </div>
</BaseLayout>
