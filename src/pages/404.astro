---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 Page Not Found - ShadTools"
  description="The requested utility tool or page could not be found."
  noindex={true}
>
  <div class="max-w-md mx-auto my-20 p-8 text-center space-y-4 glass-card">
    <div class="w-16 h-16 rounded-2xl bg-rose-500/10 text-rose-400 mx-auto flex items-center justify-center font-black text-2xl">
      404
    </div>
    <h1 class="text-2xl font-bold text-white">Tool Page Not Found</h1>
    <p class="text-xs text-slate-400">
      The utility page you are looking for may have been moved or does not exist.
    </p>
    <a
      href="/"
      class="inline-block px-6 py-2.5 rounded-xl bg-blue-500 hover:bg-blue-600 text-white font-bold text-xs shadow-lg shadow-blue-500/20 transition-all"
    >
      Return to Homepage
    </a>
  </div>
</BaseLayout>
