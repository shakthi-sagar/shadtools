---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolSlug, getNamespaceUrl, getToolUrl } from '../lib/routing';

export async function getStaticPaths() {
  const namespaces = await getCollection('namespaces');
  const allTools = await getCollection('tools');
  const publishedTools = allTools.filter((t) => t.data.status === 'published');

  return namespaces.map((ns) => {
    const nsSlug = getNamespaceSlug(ns);
    const nsTools = publishedTools.filter((t) => {
      const toolNs = t.data.namespace || getNamespaceSlug(t);
      return toolNs === nsSlug;
    });
    return {
      params: { namespace: nsSlug },
      props: {
        meta: { name: ns.data.name, summary: ns.data.summary, slug: nsSlug },
        tools: nsTools.map((t) => ({ ...t.data, slug: getToolSlug(t), namespace: nsSlug })),
      },
    };
  });
}

const { meta, tools } = Astro.props;
const breadcrumbItems = [{ name: meta.name, url: getNamespaceUrl(meta.slug) }];
---

<BaseLayout
  title={`${meta.name} – Free Online Tools`}
  description={meta.summary}
  canonicalUrl={`https://shadtools.com/${meta.slug}`}
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-6 space-y-6" data-pagefind-body>
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Hub Header -->
    <div class="space-y-2">
      <h1 class="text-2xl sm:text-3xl font-semibold text-foreground tracking-tight">{meta.name}</h1>
      <p class="text-foreground-secondary max-w-3xl text-sm sm:text-base leading-relaxed">
        {meta.summary}
      </p>
    </div>

    <!-- Tools List (Clean Bordered Rows) -->
    <section class="space-y-3 pt-2">
      <h2 class="text-xs font-semibold text-foreground-muted uppercase tracking-wider font-sans">
        Available Tools ({tools.length})
      </h2>
      <div class="divide-y divide-border border-y border-border">
        {tools.map((tool) => (
          <a
            href={getToolUrl(tool.namespace, tool.slug)}
            class="py-3 px-2 flex items-center justify-between hover:bg-surface-subtle transition-colors group rounded-sm"
          >
            <div class="space-y-0.5 max-w-2xl">
              <h3 class="font-medium text-foreground text-sm group-hover:text-primary transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-foreground-secondary line-clamp-1">
                {tool.summary}
              </p>
            </div>
            <span class="text-xs text-foreground-muted group-hover:text-primary transition-colors flex items-center gap-1 font-medium pl-4 shrink-0">
              <span>Open tool</span>
              <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
