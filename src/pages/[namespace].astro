---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolSlug, getNamespaceUrl, getToolUrl } from '@/lib/routing';

export async function getStaticPaths() {
  const namespaces = await getCollection('namespaces');
  const publishedTools = (await getCollection('tools')).filter((tool) => tool.data.status === 'published');
  return namespaces.map((namespace) => {
    const slug = getNamespaceSlug(namespace);
    return {
      params: { namespace: slug },
      props: {
        meta: { name: namespace.data.name, summary: namespace.data.summary, slug },
        tools: publishedTools
          .filter((tool) => (tool.data.namespace || getNamespaceSlug(tool)) === slug)
          .map((tool) => ({ ...tool.data, slug: getToolSlug(tool), namespace: slug })),
      },
    };
  });
}

const { meta, tools } = Astro.props;
const breadcrumbItems = [{ name: meta.name, url: getNamespaceUrl(meta.slug) }];
---

<BaseLayout title={`${meta.name} - Free Online Tools`} description={meta.summary} canonicalUrl={`https://shadtools.com/${meta.slug}`}>
  <div class="mx-auto max-w-[1040px] px-4 py-6 sm:px-6 sm:py-9" data-pagefind-body>
    <Breadcrumbs items={breadcrumbItems} />
    <div class="mb-8 mt-6 max-w-3xl">
      <p class="mb-2 text-xs font-semibold uppercase text-accent">Tool collection</p>
      <h1 class="text-2xl font-semibold text-foreground sm:text-3xl">{meta.name}</h1>
      <p class="mt-2 text-sm leading-6 text-foreground-secondary sm:text-[15px]">{meta.summary}</p>
    </div>
    <section aria-labelledby="available-tools-heading">
      <div class="mb-3 flex items-center justify-between">
        <h2 id="available-tools-heading" class="text-sm font-semibold text-foreground">Available tools</h2>
        <span class="text-xs text-foreground-muted">{tools.length} total</span>
      </div>
      <div class="divide-y divide-border overflow-hidden rounded-lg border border-border bg-surface">
        {tools.map((tool) => (
          <a href={getToolUrl(tool.namespace, tool.slug)} class="group grid min-h-[76px] items-center gap-2 px-4 py-3 hover:bg-surface-subtle sm:grid-cols-[1fr_auto] sm:px-5">
            <span class="min-w-0">
              <span class="block text-sm font-semibold text-foreground group-hover:text-accent">{tool.name}</span>
              <span class="mt-1 block text-xs leading-5 text-foreground-muted sm:line-clamp-1">{tool.summary}</span>
            </span>
            <span class="inline-flex items-center gap-1.5 text-xs font-medium text-foreground-muted group-hover:text-accent">Open <span aria-hidden="true">&rarr;</span></span>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
