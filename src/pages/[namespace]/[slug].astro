---
import { getCollection, render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getToolRenderer, parseToolConfig } from '@/tools/registry';
import { getNamespaceSlug, getToolSlug } from '@/lib/routing';

export const getStaticPaths = async () => {
  const entries = await getCollection(
    'tools',
    ({ data }) => data.status === 'published'
  );

  return entries.map((entry) => {
    const namespace = getNamespaceSlug(entry);
    const slug = getToolSlug(entry);

    return {
      params: { namespace, slug },
      props: { entry, namespace, slug },
    };
  });
};

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, namespace, slug } = Astro.props as Props;

const Renderer = await getToolRenderer((entry as any).data.renderer);
const config = parseToolConfig((entry as any).data.renderer, (entry as any).data.config);
const { Content } = await render(entry as any);
---

<ToolLayout
  tool={(entry as any).data}
  namespace={namespace}
  slug={slug}
>
  <Renderer slot="tool" config={config} />
  <Content slot="content" />
</ToolLayout>
