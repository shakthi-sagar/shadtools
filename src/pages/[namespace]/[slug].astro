---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolRenderer, parseToolConfig } from '../../tools/registry';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection(
    'tools',
    ({ data }) => data.status === 'published' && (!data.seo || !data.seo.noindex)
  );

  return entries.map((entry) => {
    const parts = entry.slug.split('/');
    const namespace = parts[0];
    const slug = parts.length > 1 ? parts[1] : parts[0];

    return {
      params: { namespace, slug },
      props: { entry, namespace, slug },
    };
  });
};

const { entry, namespace, slug } = Astro.props;

const Renderer = await getToolRenderer(entry.data.renderer);
const config = parseToolConfig(entry.data.renderer, entry.data.config);
const { Content } = await render(entry);
---

<ToolLayout
  tool={entry.data as any}
  namespace={namespace}
  slug={slug}
>
  <Renderer slot="tool" config={config} />
  <Content slot="content" />
</ToolLayout>
