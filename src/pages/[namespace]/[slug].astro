---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ToolLayout from '../../layouts/ToolLayout.astro';
import { getToolRenderer, parseToolConfig } from '../../tools/registry';
import { getNamespaceSlug, getToolSlug } from '../../lib/routing';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection(
    'tools',
    ({ data }) => data.status === 'published'
  );

  return entries.map((entry) => {
    const namespace = getNamespaceSlug(entry);
    const slug = getToolSlug(entry);

    return {
      params: { namespace, slug },
      props: { entry, namespace, slug },
    };
  });
};

const { entry, namespace, slug } = Astro.props;

const Renderer = await getToolRenderer(entry.data.renderer);
const config = parseToolConfig(entry.data.renderer, entry.data.config);
const { Content } = await render(entry);
---

<ToolLayout
  tool={entry.data as any}
  namespace={namespace}
  slug={slug}
>
  <Renderer slot="tool" config={config} />
  <Content slot="content" />
</ToolLayout>
