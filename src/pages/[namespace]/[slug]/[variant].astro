---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import ToolLayout from '@/layouts/ToolLayout.astro';
import { getAllSeoEnabledTools, getToolRenderer } from '@/tools/registry';
import { getNamespaceSlug, getToolSlug } from '@/lib/routing';

export const getStaticPaths: GetStaticPaths = async () => {
  const seoTools = getAllSeoEnabledTools();
  const allContent = await getCollection('tools', ({ data }) => data.status === 'published');

  const paths: Array<{
    params: { namespace: string; slug: string; variant: string };
    props: Record<string, any>;
  }> = [];

  for (const { key, module } of seoTools) {
    if (!module.seoPages) continue;

    const [namespace, toolSlug] = key.split('/');
    const contentEntry = allContent.find((e) => {
      const ns = getNamespaceSlug(e);
      const sl = getToolSlug(e);
      return ns === namespace && sl === toolSlug;
    });

    if (!contentEntry) continue;

    const staticPages = module.seoPages.getStaticPages();

    for (const variantData of staticPages) {
      const variantSlug = module.seoPages.getSlug(variantData);
      const meta = module.seoPages.getMetadata(variantData);
      const result = module.seoPages.compute(variantData);
      const isIndexable = module.seoPages.isIndexable(variantData);

      const nearbyVariants = module.seoPages.getNearbyVariants
        ? module.seoPages.getNearbyVariants(variantData).map((nv) => ({
            slug: module.seoPages!.getSlug(nv),
            label: module.seoPages!.getMetadata(nv).h1,
          }))
        : [];

      const breadcrumbParent = module.seoPages.getBreadcrumbParent
        ? module.seoPages.getBreadcrumbParent(variantData)
        : null;

      const sections = module.seoPages.getSections
        ? module.seoPages.getSections(variantData)
        : undefined;

      paths.push({
        params: {
          namespace,
          slug: toolSlug,
          variant: variantSlug,
        },
        props: {
          namespace,
          toolSlug,
          tool: contentEntry.data,
          rendererKey: contentEntry.data.renderer,
          variantSlug,
          variantData,
          meta,
          result,
          noindex: !isIndexable,
          breadcrumbParent,
          sections,
          nearbyVariants,
        },
      });
    }
  }

  return paths;
};

const props = Astro.props as any;
const {
  namespace,
  toolSlug,
  tool,
  rendererKey,
  variantSlug,
  variantData,
  meta,
  result,
  noindex,
  breadcrumbParent,
  sections,
  nearbyVariants,
} = props;

const Renderer = await getToolRenderer(rendererKey);
---

<ToolLayout
  tool={tool}
  namespace={namespace}
  slug={toolSlug}
  seoVariant={{
    slug: variantSlug,
    meta,
    result,
    noindex,
    breadcrumbParent,
    sections,
    nearbyVariants,
  }}
>
  <Renderer
    slot="tool"
    config={{}}
    variantData={variantData}
    initialValue={variantData?.value}
    initialFrom={variantData?.fromId}
    initialTo={variantData?.toId}
  />
</ToolLayout>
