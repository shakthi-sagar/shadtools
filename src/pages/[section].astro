---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/site/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const namespaces = await getCollection('namespaces');
  const allTools = await getCollection('tools');
  const publishedTools = allTools.filter((t) => t.data.status === 'published');

  return namespaces.map((ns) => {
    const nsSlug = ns.slug;
    const nsTools = publishedTools.filter((t) => t.data.namespace === nsSlug);
    return {
      params: { section: nsSlug },
      props: {
        meta: { name: ns.data.name, summary: ns.data.summary, slug: nsSlug },
        tools: nsTools.map((t) => ({ ...t.data, slug: t.slug })),
      },
    };
  });
}

const { meta, tools } = Astro.props;

const breadcrumbItems = [{ name: meta.name, url: `/${meta.slug}` }];
---

<BaseLayout
  title={`${meta.name} – Free Online Tools`}
  description={meta.summary}
  canonicalUrl={`https://shadtools.com/${meta.slug}`}
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Hub Header -->
    <div class="space-y-2.5">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md text-xs font-semibold bg-surface-subtle border border-border text-foreground-secondary">
        <span>{tools.length} Tools Available</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-bold text-foreground tracking-tight">{meta.name}</h1>
      <p class="text-sm sm:text-base text-foreground-secondary max-w-3xl leading-relaxed">
        {meta.summary}
      </p>
    </div>

    <!-- Tools Rows -->
    <section class="space-y-3 pt-2">
      <h2 class="text-xs font-semibold text-foreground-muted uppercase tracking-wider font-sans">Available Tools</h2>
      <div class="divide-y divide-border border-y border-border">
        {tools.map((tool) => {
          const [ns, toolSlug] = tool.slug.includes('/') ? tool.slug.split('/') : [tool.namespace, tool.slug];
          return (
            <a
              href={`/${ns}/${toolSlug}`}
              class="py-3 px-2 flex items-center justify-between hover:bg-surface-subtle transition-colors group rounded-sm"
            >
              <div class="space-y-0.5 max-w-2xl">
                <h3 class="font-semibold text-foreground text-sm group-hover:text-accent transition-colors">
                  {tool.name}
                </h3>
                <p class="text-xs text-foreground-secondary line-clamp-1">
                  {tool.summary}
                </p>
              </div>
              <span class="text-xs text-accent font-medium group-hover:translate-x-0.5 transition-transform flex items-center gap-1 pl-4 shrink-0">
                <span>Open</span>
                <span>→</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>
