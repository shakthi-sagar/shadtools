---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  const namespaces = await getCollection('namespaces');
  const allTools = await getCollection('tools');
  const publishedTools = allTools.filter((t) => t.data.status === 'published');

  const paths = [];

  // Category paths (e.g. /developer-tools)
  for (const cat of categories) {
    const catSlug = cat.slug;
    const catNamespaces = namespaces.filter((n) => n.data.category === catSlug);
    const catTools = publishedTools.filter((t) => t.data.category === catSlug);
    paths.push({
      params: { section: catSlug },
      props: {
        type: 'category' as const,
        meta: { ...cat.data, slug: catSlug },
        namespaces: catNamespaces.map((n) => ({ ...n.data, slug: n.slug })),
        tools: catTools.map((t) => ({ ...t.data, slug: t.slug }))
      }
    });
  }

  // Namespace paths (e.g. /json, /base64)
  for (const ns of namespaces) {
    const nsSlug = ns.slug;
    const nsTools = publishedTools.filter((t) => t.data.namespace === nsSlug);
    paths.push({
      params: { section: nsSlug },
      props: {
        type: 'namespace' as const,
        meta: { ...ns.data, slug: nsSlug },
        namespaces: [],
        tools: nsTools.map((t) => ({ ...t.data, slug: t.slug }))
      }
    });
  }

  return paths;
}

const { type, meta, namespaces, tools } = Astro.props;

const breadcrumbItems = [
  { name: meta.name, url: `/${meta.slug}` }
];
---

<BaseLayout
  title={`${meta.name} - Free Online Tools`}
  description={meta.description}
  canonicalUrl={`https://shadtools.com/${meta.slug}`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <Breadcrumb items={breadcrumbItems} />

    <!-- Hub Header -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md text-xs font-semibold bg-slate-900 border border-slate-800 text-slate-300">
        <span>{tools.length} Available Tools</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">{meta.name}</h1>
      <p class="text-slate-400 max-w-3xl leading-relaxed text-sm">
        {meta.description}
      </p>
    </div>

    <!-- Category Hub: Sub-namespaces -->
    {type === 'category' && namespaces.length > 0 && (
      <section class="space-y-4 pt-2">
        <h2 class="text-lg font-bold text-white">Tool Namespaces</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
          {namespaces.map((ns) => (
            <a
              href={`/${ns.slug}`}
              class="p-5 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors block space-y-2 group"
            >
              <h3 class="font-bold text-slate-100 text-sm group-hover:text-blue-400 transition-colors">
                {ns.name}
              </h3>
              <p class="text-xs text-slate-400 line-clamp-2">{ns.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Tools Grid -->
    <section class="space-y-4 pt-2">
      <h2 class="text-lg font-bold text-white">{type === 'category' ? 'All Category Tools' : 'Available Tools'}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {tools.map((tool) => (
          <a
            href={`/${tool.namespace}/${tool.slug.includes('/') ? tool.slug.split('/')[1] : tool.slug}`}
            class="p-5 rounded-lg bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors block space-y-2 group"
          >
            <div class="flex justify-between items-start">
              <h3 class="font-semibold text-white text-sm group-hover:text-blue-400 transition-colors">
                {tool.name}
              </h3>
              <span class="text-[10px] text-slate-500 font-mono">Free</span>
            </div>
            <p class="text-xs text-slate-400 line-clamp-2 leading-relaxed">
              {tool.shortDescription}
            </p>
            <div class="pt-2 text-xs font-semibold text-blue-400 flex items-center gap-1">
              <span>Open Tool</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
