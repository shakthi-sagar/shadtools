---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us - ShadTools"
  description="Get in touch with the ShadTools team for tool requests, feedback, or business inquiries."
  canonicalUrl="https://shadtools.com/contact"
>
  <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-6 glass-card my-12 p-8">
    <h1 class="text-3xl font-extrabold text-white">Contact Us</h1>
    <p class="text-xs text-slate-300">
      Have a suggestion for a new utility tool or found an issue? Reach out to us at <a href="mailto:support@shadtools.com" class="text-blue-400 font-bold">support@shadtools.com</a>.
    </p>
  </div>
</BaseLayout>
