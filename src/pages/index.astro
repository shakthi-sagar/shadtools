---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolSlug, getNamespaceUrl, getToolUrl } from '@/lib/routing';
import { DashboardIsland } from '@/components/site/DashboardIsland';
import { ToolIcon } from '@/components/site/ToolIcon';

const namespaces = await getCollection('namespaces');
const allToolsCollection = await getCollection('tools');

const publishedTools = allToolsCollection
  .filter((e) => e.data.status === 'published')
  .map((e) => {
    const ns = getNamespaceSlug(e);
    const sl = getToolSlug(e);
    return {
      id: e.data.id || sl,
      name: e.data.name,
      namespace: ns,
      slug: sl,
      summary: e.data.summary,
      featured: e.data.featured,
      url: getToolUrl(ns, sl),
    };
  });

const sortedNamespaces = namespaces.sort((a, b) => (a.data.order || 100) - (b.data.order || 100));

const groups = Array.from(new Set(sortedNamespaces.map((n) => n.data.group))).map((groupKey) => {
  const groupItems = sortedNamespaces.filter((n) => n.data.group === groupKey);
  const groupLabel = groupItems[0]?.data.groupLabel || groupKey.charAt(0).toUpperCase() + groupKey.slice(1);
  return {
    key: groupKey,
    label: groupLabel,
    namespaces: groupItems,
  };
});
---

<BaseLayout
  title="ShadTools – Instant Browser Utilities"
  description="Fast, free, privacy-first browser utilities. Format JSON, convert units, compare text, and generate hashes instantly."
  canonicalUrl="https://shadtools.com"
>
  <section class="home-hero border-b border-border" data-pagefind-body>
    <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-14 sm:py-20">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold text-accent mb-3">Fast, free browser tools</p>
        <h1 class="text-4xl sm:text-5xl font-bold text-foreground tracking-[-0.035em] leading-[1.08]">
          Everyday tools,<br class="hidden sm:block" /> ready when you are.
        </h1>
        <p class="mt-4 text-base sm:text-lg text-foreground-secondary max-w-2xl leading-relaxed">
          Convert, format, calculate, and optimize without uploads, accounts, or unnecessary steps.
        </p>
      </div>
    </div>
  </section>

  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-10 space-y-12" data-pagefind-body>

    <!-- Personalized App Launcher Dashboard -->
    <section>
      <DashboardIsland client:load allTools={publishedTools} />
    </section>

    <!-- Explore by Tool Collections & Categories -->
    <section class="space-y-5 border-t border-border pt-10">
      <div>
        <p class="text-xs font-semibold text-accent uppercase tracking-wider">All collections</p>
        <h2 class="mt-1 text-2xl font-bold text-foreground tracking-tight">Browse by category</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {groups.map((grp) => (
          <div class="space-y-3">
            <h3 class="text-xs font-semibold text-foreground-muted uppercase tracking-wider font-sans">
              {grp.label}
            </h3>
            <div class="space-y-2">
              {grp.namespaces.map((ns) => {
                const nsSlug = getNamespaceSlug(ns);
                return (
                  <a
                    href={getNamespaceUrl(nsSlug)}
                    class="flex items-center gap-3 p-3.5 rounded-lg bg-surface border border-border hover:border-border-strong hover:-translate-y-0.5 transition-all group"
                  >
                    <ToolIcon namespace={nsSlug} id={nsSlug} className="h-10 w-10" />
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center justify-between">
                        <span class="font-semibold text-sm text-foreground group-hover:text-accent transition-colors">{ns.data.name}</span>
                        <span class="text-sm text-foreground-muted group-hover:text-accent group-hover:translate-x-0.5 transition-all">→</span>
                      </div>
                      <p class="text-xs text-foreground-secondary mt-0.5 line-clamp-1">{ns.data.summary}</p>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Client-Side Privacy Guarantee -->
    <section class="px-5 py-4 rounded-lg bg-accent-subtle border border-accent/15 text-xs flex items-center justify-between gap-4">
      <div class="flex items-center gap-2 text-foreground-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-success shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Zero server tracking. 100% client-side local calculation.</span>
      </div>
      <a href="/privacy" class="text-accent hover:underline font-mono font-medium shrink-0">Privacy Details →</a>
    </section>

  </div>
</BaseLayout>
