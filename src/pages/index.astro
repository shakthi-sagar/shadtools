---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolSlug, getNamespaceUrl, getToolUrl } from '@/lib/routing';
import { DashboardIsland } from '@/components/site/DashboardIsland';

const namespaces = await getCollection('namespaces');
const allToolsCollection = await getCollection('tools');

const publishedTools = allToolsCollection
  .filter((entry) => entry.data.status === 'published')
  .map((entry) => {
    const namespace = getNamespaceSlug(entry);
    const slug = getToolSlug(entry);
    return {
      id: entry.data.id || slug,
      name: entry.data.name,
      namespace,
      slug,
      summary: entry.data.summary,
      featured: entry.data.featured,
      url: getToolUrl(namespace, slug),
    };
  });

const groupLabels = new Map(
  namespaces
    .filter((namespace) => namespace.data.groupLabel)
    .map((namespace) => [namespace.data.group, namespace.data.groupLabel])
);

const collectionItems = namespaces
  .sort((a, b) => (a.data.order || 100) - (b.data.order || 100))
  .map((namespace) => {
    const slug = getNamespaceSlug(namespace);
    return {
      name: namespace.data.name,
      slug,
      summary: namespace.data.summary,
      groupLabel:
        namespace.data.groupLabel ||
        groupLabels.get(namespace.data.group) ||
        namespace.data.group.charAt(0).toUpperCase() + namespace.data.group.slice(1),
      toolCount: publishedTools.filter((tool) => tool.namespace === slug).length,
    };
  });
---

<BaseLayout
  title="ShadTools - Instant Browser Utilities"
  description="Fast, free, privacy-first browser utilities. Format JSON, convert units, compare text, and generate hashes instantly."
  canonicalUrl="https://shadtools.com"
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-8 sm:py-10 space-y-10" data-pagefind-body>
    <div class="flex flex-col gap-3 border-b border-border pb-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="space-y-1.5">
        <h1 class="text-2xl sm:text-3xl font-semibold text-foreground">Your toolbox</h1>
        <p class="max-w-2xl text-sm text-foreground-secondary">
          Fast browser utilities for everyday work. Your inputs stay on this device whenever the tool allows it.
        </p>
      </div>
      <div class="flex items-center gap-2 text-xs text-foreground-muted">
        <span class="rounded-md border border-border bg-surface px-2.5 py-1">{publishedTools.length} tools</span>
        <span class="rounded-md border border-border bg-surface px-2.5 py-1">No account needed</span>
      </div>
    </div>

    <section>
      <DashboardIsland client:load allTools={publishedTools} />
    </section>

    <section class="space-y-4 border-t border-border pt-8">
      <div>
        <h2 class="text-lg font-semibold text-foreground">Browse collections</h2>
        <p class="mt-0.5 text-sm text-foreground-muted">Find tools by the kind of work you are doing.</p>
      </div>

      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {collectionItems.map((collection) => (
          <a
            href={getNamespaceUrl(collection.slug)}
            class="group flex min-h-32 flex-col justify-between rounded-lg border border-border bg-surface p-4 transition-colors hover:border-border-strong hover:bg-surface-subtle"
          >
            <div>
              <span class="text-[10px] font-semibold uppercase text-accent">{collection.groupLabel}</span>
              <h3 class="mt-1 text-sm font-semibold text-foreground group-hover:text-accent">{collection.name}</h3>
              <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-foreground-secondary">{collection.summary}</p>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs text-foreground-muted">
              <span>{collection.toolCount} {collection.toolCount === 1 ? 'tool' : 'tools'}</span>
              <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="p-3.5 rounded-lg bg-surface-subtle border border-border text-xs flex flex-col items-start sm:flex-row sm:items-center justify-between gap-3">
      <div class="flex items-center gap-2 text-foreground-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-success shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Zero server tracking. Client-side local calculation by default.</span>
      </div>
      <a href="/privacy" class="text-accent hover:underline font-medium shrink-0">Privacy details &rarr;</a>
    </section>
  </div>
</BaseLayout>
