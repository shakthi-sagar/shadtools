---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolSlug, getNamespaceUrl, getToolUrl } from '../lib/routing';

const namespaces = await getCollection('namespaces');
const allTools = await getCollection('tools');
const publishedTools = allTools
  .filter((e) => e.data.status === 'published')
  .map((e) => ({
    ...e.data,
    namespace: getNamespaceSlug(e),
    slug: getToolSlug(e),
  }));

const featuredTools = publishedTools.filter((t) => t.featured);
---

<BaseLayout
  title="ShadTools – Useful tools, without unnecessary steps."
  description="Fast, free, privacy-first online utility web tools. Format JSON, convert units, compress images, and calculate formulas directly in your browser."
  canonicalUrl="https://shadtools.com"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    
    <!-- Hero / Launcher Intro -->
    <div class="space-y-4 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-slate-900 text-indigo-300 border border-slate-800">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        <span>Browser-Local Privacy First</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Useful tools, without unnecessary steps.
      </h1>
      <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
        Fast, clean utility tools for formatting, encoding, compressing, and calculating directly inside your web browser.
      </p>

      <!-- Quick Search Trigger Link -->
      <div class="pt-2">
        <a
          href="/search"
          class="inline-flex items-center justify-between w-full max-w-xl px-4 py-3 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 hover:text-slate-200 hover:border-slate-700 text-sm transition-all shadow-lg group"
        >
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span>Search all tools and keywords...</span>
          </span>
          <kbd class="text-xs font-mono px-2 py-0.5 rounded bg-slate-950 border border-slate-800 text-slate-400">Ctrl + K</kbd>
        </a>
      </div>
    </div>

    <!-- Frequently Used Tools -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-white">Frequently Used Tools</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {featuredTools.map((tool) => (
          <a
            href={getToolUrl(tool.namespace, tool.slug)}
            class="p-5 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors block space-y-2 group shadow-sm"
          >
            <div class="flex justify-between items-start">
              <h3 class="font-semibold text-white text-base group-hover:text-indigo-400 transition-colors">
                {tool.name}
              </h3>
              <span class="text-xs font-medium text-indigo-400 opacity-0 group-hover:opacity-100 transition-opacity">Open →</span>
            </div>
            <p class="text-sm text-slate-400 line-clamp-2 leading-relaxed">
              {tool.summary}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Browse Tool Collections -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-white">Browse Tool Collections</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {namespaces.map((ns) => {
          const nsSlug = getNamespaceSlug(ns);
          return (
            <a
              href={getNamespaceUrl(nsSlug)}
              class="p-5 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors block space-y-2 group"
            >
              <h3 class="font-bold text-slate-100 text-base group-hover:text-indigo-400 transition-colors">
                {ns.data.name}
              </h3>
              <p class="text-sm text-slate-400 line-clamp-2">{ns.data.summary}</p>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Local Processing Explanation -->
    <section class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800 space-y-2">
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        <span>Privacy & In-Browser Processing</span>
      </h2>
      <p class="text-sm text-slate-300 leading-relaxed">
        ShadTools is designed with strict client-side privacy. Your code snippets, payloads, images, and numbers are processed locally using standard web browser APIs. Data is never transmitted to remote analytics or storage servers.
      </p>
    </section>

  </div>
</BaseLayout>
