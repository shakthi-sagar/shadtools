---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolSlug, getToolUrl } from '@/lib/routing';
import { DashboardIsland } from '@/components/site/DashboardIsland';

const namespaces = (await getCollection('namespaces'))
  .sort((a, b) => (a.data.order || 100) - (b.data.order || 100));
const toolEntries = (await getCollection('tools')).filter((entry) => entry.data.status === 'published');

const publishedTools = toolEntries.map((entry) => {
  const namespace = getNamespaceSlug(entry);
  const slug = getToolSlug(entry);
  return {
    id: entry.data.id || `${namespace}/${slug}`,
    name: entry.data.name,
    namespace,
    slug,
    summary: entry.data.summary,
    featured: entry.data.featured,
    dashboardOrder: entry.data.dashboardOrder,
    url: getToolUrl(namespace, slug),
  };
});

const collections = namespaces.map((namespace) => {
  const slug = getNamespaceSlug(namespace);
  return {
    slug,
    name: namespace.data.name,
    summary: namespace.data.summary,
    toolCount: publishedTools.filter((tool) => tool.namespace === slug).length,
  };
});
---

<BaseLayout
  title="ShadTools - Instant Browser Utilities"
  description="Fast, free, privacy-first browser utilities. Format JSON, convert units, compare text, and generate hashes instantly."
  canonicalUrl="https://shadtools.com"
>
  <div class="mx-auto max-w-[1180px] px-4 py-7 sm:px-6 sm:py-9" data-pagefind-body>
    <div class="mb-9 max-w-2xl">
      <p class="mb-2 text-xs font-semibold uppercase text-accent">Personal utility workspace</p>
      <h1 class="text-2xl font-semibold leading-tight text-foreground sm:text-3xl">Everything you need, ready when you are.</h1>
      <p class="mt-2 text-sm leading-6 text-foreground-secondary">Fast browser tools for data, text, images, conversions, and everyday calculations.</p>
    </div>

    <DashboardIsland client:load allTools={publishedTools} collections={collections} />

    <div class="mt-10 flex flex-col gap-2 border-t border-border py-5 text-xs text-foreground-muted sm:flex-row sm:items-center sm:justify-between">
      <p>Most tools run entirely in your browser. Your inputs stay on your device.</p>
      <a href="/privacy" class="font-medium text-foreground-secondary hover:text-accent">Read the privacy policy</a>
    </div>
  </div>
</BaseLayout>
