---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolSlug, getNamespaceUrl, getToolUrl } from '../lib/routing';

const namespaces = await getCollection('namespaces');
const allTools = await getCollection('tools');

const publishedTools = allTools
  .filter((e) => e.data.status === 'published')
  .map((e) => ({
    ...e.data,
    namespace: getNamespaceSlug(e),
    slug: getToolSlug(e),
  }));

const featuredTools = publishedTools.filter((t) => t.featured);

const developerNamespaces = namespaces.filter((n) => ['json', 'base64'].includes(getNamespaceSlug(n)));
const fileNamespaces = namespaces.filter((n) => ['images'].includes(getNamespaceSlug(n)));
const calculateNamespaces = namespaces.filter((n) => ['currency', 'percentage', 'units'].includes(getNamespaceSlug(n)));
---

<BaseLayout
  title="ShadTools – Useful tools, without unnecessary steps."
  description="Fast, free, privacy-first online utility web tools. Format JSON, convert units, compress images, and calculate formulas directly in your browser."
  canonicalUrl="https://shadtools.com"
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-10 space-y-12" data-pagefind-body>
    
    <!-- Hero / Tool Launcher Intro -->
    <div class="space-y-4 max-w-2xl">
      <h1 class="text-3xl sm:text-4xl font-semibold text-foreground tracking-tight">
        Useful tools. No unnecessary steps.
      </h1>
      <p class="text-sm sm:text-base text-foreground-secondary leading-relaxed">
        Fast, clean utilities for formatting, encoding, compressing, and calculating directly inside your web browser.
      </p>

      <!-- Dominant Search Trigger -->
      <div class="pt-2">
        <a
          href="/search"
          class="flex items-center justify-between w-full px-4 py-3 rounded-md bg-surface border border-border hover:border-border-strong text-foreground-secondary hover:text-foreground text-sm transition-colors shadow-none group"
        >
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span>Search tools, converters, calculators...</span>
          </span>
          <kbd class="text-xs font-mono px-2 py-0.5 rounded bg-surface-subtle border border-border text-foreground-muted">⌘K</kbd>
        </a>
      </div>
    </div>

    <!-- Popular Tools List (Compact Clickable Rows) -->
    <section class="space-y-3">
      <h2 class="text-sm font-semibold text-foreground uppercase tracking-wider font-sans">
        Popular Tools
      </h2>
      <div class="divide-y divide-border border-y border-border">
        {featuredTools.map((tool) => (
          <a
            href={getToolUrl(tool.namespace, tool.slug)}
            class="py-3 px-2 flex items-center justify-between hover:bg-surface-subtle transition-colors group rounded-sm"
          >
            <div class="space-y-0.5 max-w-2xl">
              <h3 class="font-medium text-foreground text-sm group-hover:text-primary transition-colors">
                {tool.name}
              </h3>
              <p class="text-xs text-foreground-secondary line-clamp-1">
                {tool.summary}
              </p>
            </div>
            <span class="text-xs text-foreground-muted group-hover:text-primary transition-colors flex items-center gap-1 font-medium pl-4 shrink-0">
              <span>Open</span>
              <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Browse All Tools by Category Groups -->
    <section class="space-y-6">
      <h2 class="text-sm font-semibold text-foreground uppercase tracking-wider font-sans">
        Browse Tool Collections
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Developer Tools Group -->
        <div class="space-y-3">
          <h3 class="text-xs font-semibold text-foreground-muted uppercase tracking-wider font-sans border-b border-border pb-2">
            Developer
          </h3>
          <div class="space-y-2">
            {developerNamespaces.map((ns) => {
              const nsSlug = getNamespaceSlug(ns);
              return (
                <a
                  href={getNamespaceUrl(nsSlug)}
                  class="block p-3 rounded-md bg-surface border border-border hover:border-border-strong hover:bg-surface-subtle transition-colors group"
                >
                  <div class="flex items-center justify-between">
                    <span class="font-medium text-sm text-foreground group-hover:text-primary transition-colors">{ns.data.name}</span>
                    <span class="text-xs text-foreground-muted">→</span>
                  </div>
                  <p class="text-xs text-foreground-secondary mt-1 line-clamp-1">{ns.data.summary}</p>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Files Group -->
        <div class="space-y-3">
          <h3 class="text-xs font-semibold text-foreground-muted uppercase tracking-wider font-sans border-b border-border pb-2">
            Files
          </h3>
          <div class="space-y-2">
            {fileNamespaces.map((ns) => {
              const nsSlug = getNamespaceSlug(ns);
              return (
                <a
                  href={getNamespaceUrl(nsSlug)}
                  class="block p-3 rounded-md bg-surface border border-border hover:border-border-strong hover:bg-surface-subtle transition-colors group"
                >
                  <div class="flex items-center justify-between">
                    <span class="font-medium text-sm text-foreground group-hover:text-primary transition-colors">{ns.data.name}</span>
                    <span class="text-xs text-foreground-muted">→</span>
                  </div>
                  <p class="text-xs text-foreground-secondary mt-1 line-clamp-1">{ns.data.summary}</p>
                </a>
              );
            })}
          </div>
        </div>

        <!-- Calculate Group -->
        <div class="space-y-3">
          <h3 class="text-xs font-semibold text-foreground-muted uppercase tracking-wider font-sans border-b border-border pb-2">
            Calculate & Convert
          </h3>
          <div class="space-y-2">
            {calculateNamespaces.map((ns) => {
              const nsSlug = getNamespaceSlug(ns);
              return (
                <a
                  href={getNamespaceUrl(nsSlug)}
                  class="block p-3 rounded-md bg-surface border border-border hover:border-border-strong hover:bg-surface-subtle transition-colors group"
                >
                  <div class="flex items-center justify-between">
                    <span class="font-medium text-sm text-foreground group-hover:text-primary transition-colors">{ns.data.name}</span>
                    <span class="text-xs text-foreground-muted">→</span>
                  </div>
                  <p class="text-xs text-foreground-secondary mt-1 line-clamp-1">{ns.data.summary}</p>
                </a>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    <!-- Local Processing Note -->
    <section class="p-4 rounded-md bg-surface border border-border text-xs space-y-1">
      <p class="font-semibold text-foreground flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
        Client-Side Privacy Guarantee
      </p>
      <p class="text-foreground-secondary leading-relaxed">
        ShadTools processes input data locally inside your web browser. Snippets, numbers, and uploaded files are never transmitted to remote servers.
      </p>
    </section>

  </div>
</BaseLayout>
