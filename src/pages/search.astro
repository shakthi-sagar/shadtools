---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getNamespaceSlug, getToolSlug, getToolUrl } from '@/lib/routing';

const allTools = await getCollection('tools');
const publishedTools = allTools
  .filter((e) => e.data.status === 'published')
  .map((e) => {
    const ns = e.data.namespace || getNamespaceSlug(e);
    const slug = getToolSlug(e);
    return { ...e.data, namespace: ns, slug, id: e.id };
  });
---

<BaseLayout
  title="Search Tools – ShadTools"
  description="Search all online tools, formatters, converters, and calculators in ShadTools."
  canonicalUrl="https://shadtools.com/search"
  noindex={true}
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 py-8 space-y-8">
    <div class="space-y-2">
      <h1 class="text-2xl sm:text-3xl font-semibold text-foreground tracking-tight">Search Tools</h1>
      <p class="text-sm text-foreground-secondary">Type a keyword, tool name, or alias to instantly search all utility tools.</p>
    </div>

    <!-- Instant Catalog List & Filter Input -->
    <div class="space-y-6">
      <div id="search-input-container" class="w-full">
        <input
          type="text"
          id="tool-search-input"
          placeholder="Search JSON, Base64, Image, Length, Currency, Percentage..."
          class="w-full px-4 py-3 rounded-md bg-surface-input border border-border text-foreground text-sm font-sans placeholder:text-foreground-muted focus:outline-none focus:border-border-strong focus:ring-2 focus:ring-focus transition-colors shadow-none"
        />
      </div>

      <div class="space-y-3 pt-2">
        <h2 class="text-xs font-semibold text-foreground-muted uppercase tracking-wider font-sans">
          Catalog (<span id="visible-count">{publishedTools.length}</span> tools)
        </h2>

        <div id="search-results-list" class="divide-y divide-border border-y border-border">
          {publishedTools.map((tool) => (
            <a
              href={getToolUrl(tool.namespace, tool.slug)}
              data-search-item
              data-title={tool.name.toLowerCase()}
              data-summary={tool.summary.toLowerCase()}
              data-keywords={(tool.seo.keywords || []).join(' ').toLowerCase()}
              data-namespace={tool.namespace.toLowerCase()}
              class="py-3 px-2 flex items-center justify-between hover:bg-surface-subtle transition-colors group rounded-sm"
            >
              <div class="space-y-0.5 max-w-2xl">
                <div class="flex items-center gap-2">
                  <h3 class="font-medium text-foreground text-sm group-hover:text-primary transition-colors">
                    {tool.name}
                  </h3>
                  <span class="text-[11px] font-mono text-foreground-muted">/{tool.namespace}/{tool.slug}</span>
                </div>
                <p class="text-xs text-foreground-secondary line-clamp-1">
                  {tool.summary}
                </p>
              </div>
              <span class="text-xs text-foreground-muted group-hover:text-primary transition-colors flex items-center gap-1 font-medium pl-4 shrink-0">
                <span>Open tool</span>
                <span class="group-hover:translate-x-0.5 transition-transform">→</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const input = document.getElementById('tool-search-input');
      const items = document.querySelectorAll('[data-search-item]');
      const countEl = document.getElementById('visible-count');

      if (!input) return;

      input.addEventListener('input', function (e) {
        const query = (e.target.value || '').toLowerCase().trim();
        let visible = 0;

        items.forEach(function (item) {
          const title = item.getAttribute('data-title') || '';
          const summary = item.getAttribute('data-summary') || '';
          const keywords = item.getAttribute('data-keywords') || '';
          const ns = item.getAttribute('data-namespace') || '';

          if (!query || title.includes(query) || summary.includes(query) || keywords.includes(query) || ns.includes(query)) {
            item.style.display = 'flex';
            visible++;
          } else {
            item.style.display = 'none';
          }
        });

        if (countEl) countEl.textContent = String(visible);
      });
    })();
  </script>
</BaseLayout>
