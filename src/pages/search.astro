---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTools = await getCollection('tools');
const publishedTools = allTools
  .filter((e) => e.data.status === 'published')
  .map((e) => {
    const [ns, toolSlug] = e.id.split('/');
    return { ...e.data, namespace: ns, slug: toolSlug, id: e.id };
  });
---

<BaseLayout
  title="Search Tools – ShadTools"
  description="Search all online tools, formatters, converters, and calculators in ShadTools."
  canonicalUrl="https://shadtools.com/search"
  noindex={true}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold text-white tracking-tight">Search Tools</h1>
      <p class="text-slate-400 text-sm">Type a keyword, tool name, or alias to quickly filter tools.</p>
    </div>

    <!-- Client-side search input -->
    <div className="space-y-6">
      <div id="search" class="w-full"></div>
    </div>

    <!-- Instant Catalog List -->
    <div class="space-y-4 pt-6 border-t border-slate-800">
      <h2 class="text-lg font-bold text-white">Full Catalog ({publishedTools.length} tools)</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {publishedTools.map((tool) => (
          <a
            href={`/${tool.namespace}/${tool.slug}`}
            class="p-4 rounded-xl bg-slate-900 border border-slate-800 hover:border-slate-700 transition-colors block space-y-1 group"
          >
            <div class="flex justify-between items-center">
              <h3 class="font-semibold text-white text-base group-hover:text-indigo-400 transition-colors">
                {tool.name}
              </h3>
              <span class="text-xs text-slate-500 font-mono">/{tool.namespace}/{tool.slug}</span>
            </div>
            <p class="text-sm text-slate-400 line-clamp-2">{tool.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
