---
import { LengthConverterTool } from './LengthConverterTool';

interface Props {
  config?: any;
  initialValue?: number;
  initialFrom?: string;
  initialTo?: string;
}

const { config, initialValue, initialFrom, initialTo } = Astro.props;
---

<LengthConverterTool
  client:load
  config={config}
  initialValue={initialValue}
  initialFrom={initialFrom}
  initialTo={initialTo}
/>
