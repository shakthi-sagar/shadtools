---
import { TemperatureTool } from '@/tools/units/temperature/TemperatureTool';

interface Props {
  config?: any;
  initialValue?: number;
  initialFrom?: string;
  initialTo?: string;
  variantData?: {
    value?: number;
    fromId?: string;
    toId?: string;
  };
}

const { config, initialValue, initialFrom, initialTo, variantData } = Astro.props;
---

<TemperatureTool
  client:load
  config={config}
  initialValue={variantData?.value ?? initialValue}
  initialFrom={variantData?.fromId ?? initialFrom}
  initialTo={variantData?.toId ?? initialTo}
/>
